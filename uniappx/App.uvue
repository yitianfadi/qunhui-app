<style>
  /* 全局基础样式：页面背景由 pages.json globalStyle.backgroundColor 提供
     （uni-app x app 端 uvue 仅支持类名选择器，不能使用 page 标签选择器） */
  .card {
    background-color: var(--card);
    border-radius: 8px;
    margin: 8px 12px;
    padding: 12px;
  }
  .btn-primary {
    background-color: var(--brand);
    color: var(--on-brand);
    border-radius: 8px;
    height: 44px;
    /* app 端 uvue 中 text-align 不会从 view 继承给子 text，
       用 flex 居中才能让内部 <text> 真正水平垂直居中 */
    flex-direction: row;
    justify-content: center;
    align-items: center;
    font-size: 16px;
  }
  /* 注意：App.uvue 全局样式里 color 用 var() 不生效（实测渲染成黑色），
     所以这里保留固定色；需要跟随主题的文字类，在使用它的组件里各定义一份。 */
  .text-secondary {
    color: #8a8f99;
    font-size: 12px;
  }
  .text-error {
    color: #d94838;
    font-size: 13px;
  }
</style>
