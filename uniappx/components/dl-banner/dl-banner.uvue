<template>
  <view v-if="active > 0" class="dl-banner" @click="openDlPage">
    <text class="banner-icon">⬇️</text>
    <view class="banner-main">
      <view class="banner-line">
        <text class="banner-name" max-lines="1">{{ currentName }}</text>
        <text v-if="active > 1" class="banner-count">+{{ active - 1 }} 个</text>
      </view>
      <view class="banner-bar">
        <view class="banner-bar-in" :style="'width:' + percent + '%'" />
      </view>
    </view>
    <text class="banner-pct">{{ percent }}%</text>
  </view>
</template>

<script setup>
import { computed } from 'vue'
import { dlTaskList, dlActiveCount } from '@/utils/download_manager.uts'

const active = computed(() => dlActiveCount())

const currentName = computed(() => {
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'downloading') return list[i].name
  }
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'waiting') return list[i].name
  }
  return ''
})

const percent = computed(() => {
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'downloading') return list[i].percent
  }
  return 0
})

function openDlPage() {
  uni.navigateTo({ url: '/pages/downloads/downloads' })
}
</script>

<style>
  .dl-banner {
    position: fixed;
    left: 10px;
    right: 10px;
    bottom: 62px;
    flex-direction: row;
    align-items: center;
    background-color: #ffffff;
    border-radius: 10px;
    padding: 8px 12px;
    border: 1px solid #e4ebf3;
  }
  .banner-icon {
    font-size: 16px;
    margin-right: 8px;
  }
  .banner-main {
    flex: 1;
    flex-direction: column;
  }
  .banner-line {
    flex-direction: row;
    align-items: center;
  }
  .banner-name {
    flex: 1;
    font-size: 12px;
    color: #333333;
  }
  .banner-count {
    font-size: 11px;
    color: #1e6bb8;
    margin-left: 6px;
  }
  .banner-bar {
    height: 4px;
    border-radius: 2px;
    background-color: #eef1f5;
    margin-top: 5px;
    overflow: hidden;
  }
  .banner-bar-in {
    height: 4px;
    border-radius: 2px;
    background-color: #1e6bb8;
  }
  .banner-pct {
    font-size: 12px;
    color: #1e6bb8;
    margin-left: 10px;
  }
</style>
