<template>
  <view class="tp-page" :style="themeVars()">
    <!-- 分段：上传 / 下载 / 下载站 -->
    <view class="seg">
      <text class="seg-item" :class="seg === 0 ? 'seg-on' : 'seg-off'" @click="seg = 0">上传 {{ upBadge }}</text>
      <text class="seg-item" :class="seg === 1 ? 'seg-on' : 'seg-off'" @click="seg = 1">下载 {{ dlBadge }}</text>
      <text class="seg-item" :class="seg === 2 ? 'seg-on' : 'seg-off'" @click="seg = 2">下载站</text>
    </view>

    <!-- 上传队列 -->
    <scroll-view v-if="seg === 0" class="list" direction="vertical">
      <view class="summary">
        <view class="sum-left">
          <text class="sum-title">上传任务</text>
          <text class="sum-sub">{{ upActive }} 个进行中 · 已完成 {{ upDone }}</text>
        </view>
        <text v-if="failedCount > 0" class="sum-link" @click="retryFailed">重试失败 {{ failedCount }}</text>
        <text v-if="upActive > 0" class="sum-link sum-link-gap" @click="cancelAll">全部取消</text>
        <text v-if="finishedUp > 0" class="sum-link sum-link-gap" @click="clearUp">清空已结束</text>
      </view>

      <view v-for="(t, index) in upList" :key="t.id" class="task">
        <view class="task-head">
          <text class="task-icon">📤</text>
          <view class="task-main">
            <text class="task-name" max-lines="1">{{ t.name }}</text>
            <text class="task-meta">{{ t.timeText }} · {{ upStatusText(t) }}</text>
          </view>
          <text v-if="isUpActive(t) === true" class="task-act task-act-danger" @click="cancelUp(t.id)">取消</text>
          <text v-else class="task-act task-act-primary" @click="retryUp(t.id)">重试</text>
        </view>
        <view v-if="t.status === 'uploading'" class="bar">
          <view class="bar-in" :style="'width:' + t.percent + '%'" />
        </view>
        <view class="task-foot">
          <text v-if="t.status === 'failed'" class="task-err" max-lines="1">{{ t.error }}</text>
          <text v-else class="task-size">{{ t.sizeText }}</text>
          <text class="task-del" @click="removeUp(t.id)">删除记录</text>
        </view>
      </view>

      <view v-if="upList.length === 0" class="empty-box">
        <text class="empty-icon">📤</text>
        <text class="empty-title">还没有上传任务</text>
        <text class="empty-hint">在「设置 → 备份与恢复」里选手机照片、视频或任意文件上传到 NAS</text>
      </view>
      <view class="bottom-space" />
    </scroll-view>

    <!-- 下载队列（NAS → 手机） -->
    <scroll-view v-else-if="seg === 1" class="list" direction="vertical">
      <view class="summary">
        <view class="sum-left">
          <text class="sum-title">下载任务</text>
          <text class="sum-sub">{{ dlActive }} 个进行中 · 已完成 {{ dlDone }}</text>
        </view>
        <text v-if="finishedDl > 0" class="sum-link" @click="clearDl">清空已结束</text>
      </view>

      <!-- 批量下载组进度（文件夹批量下载） -->
      <view v-for="(g, gi) in dlGroups" :key="'g' + gi" class="task">
        <view class="task-head">
          <text class="task-icon">📁</text>
          <view class="task-main">
            <text class="task-name" max-lines="1">批量下载 · {{ g.name }}</text>
            <text class="task-meta">{{ dlGroupMeta(g) }}</text>
          </view>
          <text v-if="g.active" class="task-act task-act-danger" @click="cancelGroup(g.id)">取消整组</text>
        </view>
      </view>

      <view v-for="(t, index) in dlList" :key="t.id" class="task">
        <view class="task-head">
          <text class="task-icon">{{ iconOf(t.name) }}</text>
          <view class="task-main">
            <text class="task-name" max-lines="1">{{ t.name }}</text>
            <text class="task-meta">{{ t.timeText }} · {{ dlStatusText(t) }}</text>
          </view>
          <text v-if="isDlActive(t) === true" class="task-act task-act-danger" @click="cancelDl(t.id)">取消</text>
          <text v-else-if="t.status === 'done'" class="task-act task-act-primary" @click="openDl(t)">打开</text>
          <text v-else class="task-act task-act-primary" @click="retryDl(t.id)">重试</text>
        </view>
        <view v-if="t.status === 'downloading'" class="bar">
          <view class="bar-in" :style="'width:' + t.percent + '%'" />
        </view>
        <view class="task-foot">
          <text v-if="t.status === 'failed'" class="task-err" max-lines="1">{{ t.error }}</text>
          <text v-else class="task-size">{{ t.sizeText }}</text>
          <text class="task-del" @click="removeDl(t.id)">删除记录</text>
        </view>
      </view>

      <view v-if="dlList.length === 0" class="empty-box">
        <text class="empty-icon">📥</text>
        <text class="empty-title">暂无下载任务</text>
        <text class="empty-hint">在「文件」或「照片」页选择下载到本机后，任务会显示在这里</text>
      </view>
      <view class="bottom-space" />
    </scroll-view>

    <!-- 下载站（NAS 上的 DownloadStation） -->
    <view v-else class="ds-wrap">
      <downloads-view />
    </view>
  </view>
</template>

<script setup>
import { computed, ref } from 'vue'
import { themeVars } from '@/utils/theme.uts'
import {
  upTaskList,
  upActiveCount,
  upDoneCount,
  cancelUpTask,
  removeUpTask,
  clearFinishedUpTasks,
  retryUpTask,
  retryAllFailedUpTasks,
  cancelAllUpTasks,
  UpTask,
} from '@/utils/upload_manager.uts'
import {
  dlTaskList,
  dlActiveCount,
  dlDoneCount,
  cancelDlTask,
  removeDlTask,
  clearFinishedDlTasks,
  retryDlTask,
  cancelDlGroup,
  dlGroupProgress,
  DlTask,
} from '@/utils/download_manager.uts'

/** 0=上传 1=下载 2=下载站 */
const seg = ref(0)

const upList = upTaskList
const dlList = dlTaskList

const upActive = computed(() => upActiveCount())
const upDone = computed(() => upDoneCount())
const dlActive = computed(() => dlActiveCount())
const dlDone = computed(() => dlDoneCount())

const upBadge = computed(() => (upActive.value > 0 ? upActive.value.toString() : ''))
const dlBadge = computed(() => (dlActive.value > 0 ? dlActive.value.toString() : ''))

const failedCount = computed(() => {
  let n = 0
  for (let i = 0; i < upList.value.length; i++) {
    if (upList.value[i].status === 'failed') n = n + 1
  }
  return n
})

const finishedUp = computed(() => {
  let n = 0
  for (let i = 0; i < upList.value.length; i++) {
    const s = upList.value[i].status
    if (s !== 'waiting' && s !== 'uploading') n = n + 1
  }
  return n
})

const finishedDl = computed(() => {
  let n = 0
  for (let i = 0; i < dlList.value.length; i++) {
    const s = dlList.value[i].status
    if (s !== 'waiting' && s !== 'downloading') n = n + 1
  }
  return n
})

/** 批量下载组的展示行 */
type DlGroupRow = {
  id: string
  name: string
  total: number
  done: number
  failed: number
  active: boolean
}

/** 批量下载组（文件夹批量下载）：聚合同组任务，最新的组在上 */
const dlGroups = computed<Array<DlGroupRow>>(() => {
  const ids: Array<string> = []
  const names: Map<string, string> = new Map()
  for (let i = 0; i < dlList.value.length; i++) {
    const t = dlList.value[i]
    if (t.groupId.length === 0) continue
    if (names.get(t.groupId) == null) {
      ids.push(t.groupId)
      names.set(t.groupId, t.groupName)
    }
  }
  const out: Array<DlGroupRow> = []
  for (let k = ids.length - 1; k >= 0; k--) {
    const p = dlGroupProgress(ids[k])
    out.push({
      id: ids[k],
      name: names.get(ids[k]) ?? '',
      total: p.total,
      done: p.done,
      failed: p.failed,
      active: p.active,
    })
  }
  return out
})

function dlGroupMeta(g: DlGroupRow): string {
  let s = g.done.toString() + '/' + g.total.toString() + ' 完成'
  if (g.failed > 0) s = s + ' · 失败 ' + g.failed.toString()
  if (g.active) s = s + ' · 进行中'
  return s
}

function cancelGroup(id: string) {
  cancelDlGroup(id)
  uni.showToast({ title: '已取消整组下载', icon: 'none' })
}

// ---------------- 上传 ----------------

function isUpActive(t: UpTask): boolean {
  return t.status === 'waiting' || t.status === 'uploading'
}

function upStatusText(t: UpTask): string {
  if (t.status === 'waiting') return '排队中'
  if (t.status === 'uploading') return '上传中 ' + t.percent + '%'
  if (t.status === 'done') return '已完成'
  if (t.status === 'canceled') return '已取消'
  return '上传失败'
}

function cancelUp(id: string) {
  cancelUpTask(id)
}

function retryUp(id: string) {
  retryUpTask(id)
  uni.showToast({ title: '已重新加入队列', icon: 'none' })
}

function removeUp(id: string) {
  removeUpTask(id)
}

function clearUp() {
  clearFinishedUpTasks()
  uni.showToast({ title: '已清理结束的任务', icon: 'none' })
}

function retryFailed() {
  const n = retryAllFailedUpTasks()
  uni.showToast({ title: '已重试 ' + n + ' 项', icon: 'none' })
}

function cancelAll() {
  const n = cancelAllUpTasks()
  uni.showToast({ title: '已取消 ' + n + ' 项', icon: 'none' })
}

// ---------------- 下载 ----------------

function isDlActive(t: DlTask): boolean {
  return t.status === 'waiting' || t.status === 'downloading'
}

function dlStatusText(t: DlTask): string {
  if (t.status === 'waiting') return '等待中'
  if (t.status === 'downloading') return '下载中 ' + t.percent + '%'
  if (t.status === 'done') return '已完成'
  if (t.status === 'canceled') return '已取消'
  return '下载失败'
}

function iconOf(name: string): string {
  const n = name.toLowerCase()
  if (n.indexOf('.mp4') >= 0 || n.indexOf('.mkv') >= 0 || n.indexOf('.mov') >= 0 || n.indexOf('.avi') >= 0) return '🎬'
  if (n.indexOf('.jpg') >= 0 || n.indexOf('.jpeg') >= 0 || n.indexOf('.png') >= 0 || n.indexOf('.heic') >= 0) return '🖼️'
  if (n.indexOf('.zip') >= 0 || n.indexOf('.rar') >= 0 || n.indexOf('.7z') >= 0) return '🗜️'
  if (n.indexOf('.pdf') >= 0) return '📕'
  if (n.indexOf('.mp3') >= 0 || n.indexOf('.flac') >= 0 || n.indexOf('.wav') >= 0) return '🎵'
  return '📄'
}

function openDl(t: DlTask) {
  if (t.savedPath.length === 0) {
    uni.showToast({ title: '文件不存在', icon: 'none' })
    return
  }
  // #ifdef WEB
  uni.showToast({ title: '请在浏览器下载记录中查看', icon: 'none' })
  // #endif
  // #ifndef WEB
  uni.openDocument({
    filePath: t.savedPath,
    showMenu: true,
    fail: () => {
      uni.showToast({ title: '无法打开该文件格式', icon: 'none' })
    },
  })
  // #endif
}

function cancelDl(id: string) {
  cancelDlTask(id)
}

function retryDl(id: string) {
  retryDlTask(id)
  uni.showToast({ title: '已重新加入队列', icon: 'none' })
}

function removeDl(id: string) {
  removeDlTask(id)
}

function clearDl() {
  clearFinishedDlTasks()
  uni.showToast({ title: '已清理结束的任务', icon: 'none' })
}
</script>

<style>
  .tp-page {
    flex: 1;
    background-color: var(--bg);
  }
  .seg {
    flex-direction: row;
    align-items: center;
    background-color: var(--card);
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
  }
  .seg-item {
    flex: 1;
    text-align: center;
    font-size: 14px;
    padding: 8px 0;
    border-radius: 8px;
  }
  .seg-on {
    background-color: var(--soft);
    color: var(--brand);
    font-weight: bold;
  }
  .seg-off {
    color: var(--t3);
  }
  .list {
    flex: 1;
  }
  .ds-wrap {
    flex: 1;
  }
  .summary {
    flex-direction: row;
    align-items: center;
    padding: 12px 16px 10px 16px;
  }
  .sum-left {
    flex: 1;
    flex-direction: column;
  }
  .sum-title {
    font-size: 15px;
    font-weight: bold;
    color: var(--t1);
  }
  .sum-sub {
    font-size: 12px;
    color: var(--t3);
    margin-top: 3px;
  }
  .sum-link {
    font-size: 12px;
    color: var(--brand);
    padding: 6px 2px;
  }
  .sum-link-gap {
    margin-left: 8px;
  }
  .task {
    background-color: var(--card);
    border-radius: 10px;
    margin: 6px 12px;
    padding: 12px 14px 13px 14px;
    flex-direction: column;
  }
  .task-head {
    flex-direction: row;
    align-items: center;
  }
  .task-icon {
    font-size: 24px;
    margin-right: 10px;
  }
  .task-main {
    flex: 1;
    flex-direction: column;
  }
  .task-name {
    font-size: 14px;
    color: var(--t1);
  }
  .task-meta {
    font-size: 12px;
    color: var(--t3);
    margin-top: 3px;
  }
  .task-act {
    font-size: 13px;
    padding: 6px 8px;
  }
  .task-act-primary {
    color: var(--brand);
  }
  .task-act-danger {
    color: var(--danger);
  }
  .bar {
    height: 4px;
    background-color: var(--line);
    border-radius: 2px;
    margin-top: 10px;
    overflow: hidden;
  }
  .bar-in {
    height: 4px;
    background-color: var(--brand);
  }
  .task-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
  }
  .task-size {
    flex: 1;
    font-size: 12px;
    color: var(--t3);
  }
  .task-err {
    flex: 1;
    font-size: 12px;
    color: var(--danger);
  }
  .task-del {
    font-size: 12px;
    color: var(--t3);
    padding-left: 10px;
  }
  .empty-box {
    align-items: center;
    padding: 60px 24px;
  }
  .empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
  }
  .empty-title {
    font-size: 15px;
    color: var(--t2);
  }
  .empty-hint {
    font-size: 12px;
    color: var(--t3);
    margin-top: 8px;
    text-align: center;
  }
  .bottom-space {
    height: 24px;
  }
</style>
