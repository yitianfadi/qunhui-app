<template>
  <view class="files-page" :style="themeVars()">
    <!-- 选择模式工具条 -->
    <view v-if="selectMode" class="sel-bar">
      <text class="sel-cancel" @click="exitSelect">取消</text>
      <text class="sel-count">已选 {{ selectedPaths.length }} 项</text>
      <text class="sel-all" @click="toggleSelectAll">{{ allSelected() ? '取消全选' : '全选' }}</text>
    </view>

    <!-- 路径栏 -->
    <view v-if="selectMode === false" class="path-bar">
      <text class="up-btn" :class="stack.length > 0 ? 'up-btn-on' : 'up-btn-off'" @click="goUp">↑</text>
      <text class="path-text">{{ inRecycle ? recycleShare + ' · 回收站' : currentPath }}</text>
      <text v-if="items.length > 0" class="bar-btn" @click="enterSelect">☑</text>
      <text v-if="inRecycle === false" class="bar-btn" @click="openSearch">🔍</text>
      <text v-if="inRecycle === false" class="bar-btn" @click="pickSort">⇅</text>
      <text v-if="inRecycle === false && stack.length > 0" class="bar-btn" @click="downloadWholeFolder(currentFolderPath())">⬇️</text>
      <text v-if="inRecycle" class="recycle-clear" @click="emptyRecycle">清空</text>
      <text class="refresh-btn" @click="load">⟳</text>
    </view>

    <!-- 搜索/排序状态条 -->
    <view v-if="keyword.length > 0 || sortHint.length > 0" class="state-bar">
      <text v-if="keyword.length > 0" class="state-text">搜索「{{ keyword }}」· {{ items.length }} 项</text>
      <text v-else class="state-text">排序：{{ sortHint }}</text>
      <text v-if="keyword.length > 0" class="state-x" @click="clearSearch">清除</text>
    </view>

    <scroll-view class="list" direction="vertical">
      <text v-if="errorMsg.length > 0" class="text-error error-center">{{ errorMsg }}</text>
      <view
        v-for="(item, index) in items"
        :key="index"
        class="file-row"
        :class="isSelected(item.path) ? 'file-row-on' : ''"
        @click="onRowClick(item)"
        @longpress="onLongPress(item)"
      >
        <text class="file-icon">{{ item.isDir ? '📁' : '📄' }}</text>
        <view class="file-info">
          <text class="file-name">{{ item.name }}</text>
          <text v-if="item.isDir === false" class="text-secondary" max-lines="1">{{ keyword.length > 0 ? item.path : formatSize(item.size) }}</text>
        </view>
        <text v-if="selectMode && selectable(item)" class="check" :class="isSelected(item.path) ? 'check-on' : 'check-off'">{{ isSelected(item.path) ? '✓' : '' }}</text>
        <text v-else-if="item.isDir === true || selectMode" class="chevron">›</text>
      </view>
      <view v-if="items.length === 0 && errorMsg.length === 0" class="empty-box">
        <text class="text-secondary">暂无内容</text>
      </view>
      <view class="list-bottom-space" />
    </scroll-view>

    <!-- 文件操作弹层 -->
    <view v-if="actionItem != null" class="mask" @click="actionItem = null">
      <view class="sheet" @click.stop="">
        <text class="sheet-title">{{ actionItem?.name }}</text>
        <view class="sheet-item" @click="downloadFile">
          <text>⬇️ 下载到本机</text>
        </view>
        <view class="sheet-item" @click="makeShareLink">
          <text>🔗 创建共享链接</text>
        </view>
        <view class="sheet-item" @click="renameItem(actionItem)">
          <text>✏️ 重命名</text>
        </view>
        <view class="sheet-item" @click="startMove(actionItem, 'move')">
          <text>📦 移动到…</text>
        </view>
        <view class="sheet-item" @click="startMove(actionItem, 'copy')">
          <text>📑 复制到…</text>
        </view>
        <view class="sheet-item" @click="deleteFile">
          <text style="color:#d94838;">🗑️ 删除</text>
        </view>
        <view class="sheet-item" @click="actionItem = null">
          <text class="text-secondary">取消</text>
        </view>
      </view>
    </view>

    <!-- 下载进度与完成提示统一在「下载管理」页展示，此处不再弹框 -->

    <!-- 移动/复制的目标目录选择 -->
    <folder-picker
      v-if="pickerOpen === true"
      :title="pickerTitle"
      @select="onPickDest"
      @close="pickerOpen = false"
    />

    <!-- 批量操作条 -->
    <view v-if="selectMode && selectedPaths.length > 0" class="batch-bar">
      <text class="batch-btn" @click="batchDownload">备份到本机</text>
      <text class="batch-btn" @click="batchMove('move')">移动</text>
      <text class="batch-btn" @click="batchMove('copy')">复制</text>
      <text class="batch-btn batch-danger" @click="batchDelete">删除</text>
    </view>

    <!-- 新建文件夹 FAB（回收站里不允许新建；选择模式下不显示） -->
    <view v-if="stack.length > 0 && inRecycle === false && selectMode === false" class="fab" @click="createFolder">
      <text class="fab-text">＋📁</text>
    </view>
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { api, formatSize, FileItem } from '@/utils/syno.uts'
import { themeVars } from '@/utils/theme.uts'
import { startDownload, startDownloadBatch, DlBatchItem } from '@/utils/download_manager.uts'
import { scanFolder, enqueueFolderDownloads, FolderScan } from '@/utils/backup_helper.uts'

const stack = ref<Array<string>>([])
const items = ref<Array<FileItem>>([])
/** 当前目录的完整列表（搜索时先从这里过滤，保证不依赖 NAS 索引服务） */
const rawItems = ref<Array<FileItem>>([])
const errorMsg = ref('')
const loading = ref(false)
const actionItem = ref<FileItem | null>(null)
/** 多选模式 */
const selectMode = ref(false)
/** 已选中的文件/目录绝对路径 */
const selectedPaths = ref<Array<string>>([])
const shareLink = ref('')

const currentPath = ref('/')
/** 是否处于回收站视图；非空时 recycleShare 是所属共享名（如 photo） */
const inRecycle = ref(false)
const recycleShare = ref('')

function refreshPath() {
  currentPath.value = stack.value.length === 0 ? '/' : '/' + stack.value.join('/')
}

async function load() {
  if (loading.value) return
  loading.value = true
  errorMsg.value = ''
  // 目录切换时加载：弹加载动画，加载完成后再显示内容
  uni.showLoading({ title: '加载中', mask: true } as any)
  try {
    if (stack.value.length === 0) {
      items.value = await api.listShares()
    } else {
      items.value = await api.listFiles(currentPath.value)
    }
    items.value = applySort(items.value)
    rawItems.value = items.value
  } catch (e) {
    let msg = e instanceof Error ? e.message : String(e)
    // 没启用回收站的共享，进 #recycle 会报「文件不存在」，这里换成可读文案
    if (inRecycle.value && (msg.indexOf('408') >= 0 || msg.indexOf('不存在') >= 0 || msg.indexOf('not exist') >= 0)) {
      msg = '该共享文件夹没有回收站（可能未启用或已清空）'
    }
    errorMsg.value = msg
    items.value = []
  } finally {
    uni.hideLoading()
    loading.value = false
  }
}

load()

function openItem(item: FileItem) {
  // 搜索结果里点目录：按绝对路径跳转（当前栈和结果目录未必有父子关系）
  if (keyword.value.length > 0 && item.isDir) {
    jumpTo(item.path)
    return
  }
  if (inRecycle.value) {
    if (item.isDir) {
      stack.value.push(item.name)
      refreshPath()
      items.value = []
      load()
    } else {
      showRecycleActions(item)
    }
    return
  }
  if (item.isDir) {
    keyword.value = ''
    stack.value.push(item.name)
    refreshPath()
    items.value = [] // 先清空旧目录内容，避免残留
    load()
  } else {
    actionItem.value = item
  }
}

// ---------------- 回收站 ----------------

/** 进入某个共享文件夹的回收站（#recycle） */
function openRecycle(item: FileItem) {
  inRecycle.value = true
  recycleShare.value = '/' + item.name
  stack.value = [item.name, '#recycle']
  refreshPath()
  items.value = []
  errorMsg.value = ''
  load()
}

/** 回收站里的文件：还原 / 彻底删除 */
function showRecycleActions(item: FileItem) {
  uni.showActionSheet({
    itemList: ['还原到共享根目录', '彻底删除'],
    success: async (res) => {
      if (res.tapIndex === 0) {
        await restoreItem(item)
      } else {
        confirmPurge(item)
      }
    },
  })
}

async function restoreItem(item: FileItem) {
  // /photo/#recycle/2024/a.jpg → 还原到 /photo
  const share = recycleShare.value
  if (share.length === 0) return
  uni.showLoading({ title: '还原中', mask: true } as any)
  try {
    await api.copyMove([item.path], share, true, true)
    uni.hideLoading()
    uni.showToast({ title: '已还原到 ' + share, icon: 'none' })
    load()
  } catch (e) {
    uni.hideLoading()
    uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
  }
}

function confirmPurge(item: FileItem) {
  uni.showModal({
    title: '彻底删除',
    content: '确定永久删除 ' + item.name + '？此操作不可恢复。',
    success: async (res) => {
      if (!res.confirm) return
      try {
        await api.deleteFiles([item.path])
        uni.showToast({ title: '已删除', icon: 'none' })
        load()
      } catch (e) {
        uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      }
    },
  })
}

function emptyRecycle() {
  const share = recycleShare.value
  if (share.length === 0) return
  uni.showModal({
    title: '清空回收站',
    content: '将永久删除 ' + share + '/#recycle 下的全部内容，不可恢复。',
    success: async (res) => {
      if (!res.confirm) return
      uni.showLoading({ title: '清理中', mask: true } as any)
      try {
        await api.deleteFiles([share + '/#recycle'])
        uni.hideLoading()
        uni.showToast({ title: '回收站已清空', icon: 'none' })
        items.value = []
        load()
      } catch (e) {
        uni.hideLoading()
        uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      }
    },
  })
}

/** 长按：文件弹操作面板；文件夹弹菜单（含回收站、重命名、移动、复制、删除） */
function onLongPress(item: FileItem) {
  if (!item.isDir) {
    actionItem.value = item
    return
  }
  if (stack.value.length === 0) {
    uni.showActionSheet({
      itemList: ['进入文件夹', '打开回收站', '重命名', '移动到…', '复制到…', '下载全部文件', '删除'],
      success: (res) => handleDirAction(item, res.tapIndex),
    })
    return
  }
  uni.showActionSheet({
    itemList: ['进入文件夹', '重命名', '移动到…', '复制到…', '下载全部文件', '删除'],
    success: (res) => handleDirAction(item, res.tapIndex),
  })
}

function handleDirAction(item: FileItem, index: number) {
  const atRoot = stack.value.length === 0
  // 根目录与普通目录的菜单项索引不同，这里按序拆开
  if (atRoot) {
    if (index === 0) { openItem(item); return }
    if (index === 1) { openRecycle(item); return }
    if (index === 2) { renameItem(item); return }
    if (index === 3) { startMove(item, 'move'); return }
    if (index === 4) { startMove(item, 'copy'); return }
    if (index === 5) { backupFolderToDevice(item); return }
    if (index === 6) { confirmDeleteItem(item); return }
    return
  }
  if (index === 0) { openItem(item); return }
  if (index === 1) { renameItem(item); return }
  if (index === 2) { startMove(item, 'move'); return }
  if (index === 3) { startMove(item, 'copy'); return }
  if (index === 4) { backupFolderToDevice(item); return }
  if (index === 5) { confirmDeleteItem(item); return }
}

/** 删除单个文件/文件夹（带确认） */
function confirmDeleteItem(item: FileItem) {
  uni.showModal({
    title: '删除确认',
    content: '确定删除 ' + item.name + '？可在回收站恢复（若已启用）。',
    success: async (res) => {
      if (!res.confirm) return
      try {
        await api.deleteFiles([item.path])
        uni.showToast({ title: '已删除', icon: 'none' })
        load()
      } catch (e) {
        uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      }
    },
  })
}

// ---------------- 重命名 / 移动 / 复制 ----------------

function renameItem(item: FileItem) {
  actionItem.value = null
  uni.showModal({
    title: '重命名',
    editable: true,
    placeholderText: item.name,
    success: async (res) => {
      if (!res.confirm) return
      const name = res.content != null ? res.content.trim() : ''
      if (name.length === 0 || name === item.name) return
      try {
        await api.rename(item.path, name)
        uni.showToast({ title: '已重命名', icon: 'none' })
        load()
      } catch (e) {
        uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      }
    },
  })
}

const pickerOpen = ref(false)
const pickerTitle = ref('选择目标文件夹')
let pendingPaths: Array<string> = []
let moveMode = 'move'

function startMove(item: FileItem, mode: string) {
  actionItem.value = null
  pendingPaths = [item.path]
  moveMode = mode
  pickerTitle.value = mode === 'move' ? '移动到…' : '复制到…'
  pickerOpen.value = true
}

async function onPickDest(dest: string) {
  pickerOpen.value = false
  const paths = pendingPaths
  pendingPaths = []
  if (paths.length === 0) return
  const isMove = moveMode === 'move'
  uni.showLoading({ title: isMove ? '移动中' : '复制中', mask: true } as any)
  try {
    await api.copyMove(paths, dest, isMove, false)
    uni.hideLoading()
    uni.showToast({ title: (isMove ? '已移动 ' : '已复制 ') + paths.length + ' 项', icon: 'none' })
    exitSelect()
    load()
  } catch (e) {
    uni.hideLoading()
    uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
  }
}

// ---------------- 多选批量操作 ----------------

function enterSelect() {
  selectMode.value = true
  selectedPaths.value = []
}

function exitSelect() {
  selectMode.value = false
  selectedPaths.value = []
}

/** 系统目录（#recycle、@eaDir 等）不参与批量操作 */
function selectable(item: FileItem): boolean {
  return item.name !== '#recycle' && item.name !== '@eaDir' && item.name !== '@Recycle'
}

function isSelected(path: string): boolean {
  return selectedPaths.value.indexOf(path) >= 0
}

function toggleSelect(path: string) {
  const idx = selectedPaths.value.indexOf(path)
  if (idx >= 0) {
    selectedPaths.value.splice(idx, 1)
  } else {
    selectedPaths.value.push(path)
  }
}

function allSelected(): boolean {
  return items.value.length > 0 && selectedPaths.value.length >= items.value.length
}

function toggleSelectAll() {
  if (allSelected()) {
    selectedPaths.value = []
    return
  }
  const next: Array<string> = []
  for (let i = 0; i < items.value.length; i++) {
    if (selectable(items.value[i])) {
      next.push(items.value[i].path)
    }
  }
  selectedPaths.value = next
}

/** 行点击：选择模式下切换勾选，平时进入目录/弹操作层 */
function onRowClick(item: FileItem) {
  if (selectMode.value) {
    if (!selectable(item)) {
      uni.showToast({ title: '系统目录不支持批量操作', icon: 'none' })
      return
    }
    toggleSelect(item.path)
    return
  }
  openItem(item)
}

/** 批量删除（一次请求，DSM 的 path 支持数组） */
function batchDelete() {
  const paths = selectedPaths.value.slice()
  if (paths.length === 0) return
  uni.showModal({
    title: '批量删除',
    content: '确定删除选中的 ' + paths.length + ' 项？可在回收站恢复（若已启用）。',
    success: async (res) => {
      if (!res.confirm) return
      uni.showLoading({ title: '删除中', mask: true } as any)
      try {
        await api.deleteFiles(paths)
        uni.hideLoading()
        uni.showToast({ title: '已删除 ' + paths.length + ' 项', icon: 'none' })
        exitSelect()
        load()
      } catch (e) {
        uni.hideLoading()
        uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      }
    },
  })
}

/** 当前目录的绝对路径（工具栏「下载全部」用） */
function currentFolderPath(): string {
  return currentPath.value
}

/**
 * 下载整个文件夹（含子目录）到本机：
 * 先扫描统计 → 数量多时弹确认 → 确认后分批入队（UI 不卡顿）
 */
async function downloadWholeFolder(folderPath: string) {
  uni.showLoading({ title: '扫描目录中', mask: true } as any)
  let scan: FolderScan
  try {
    scan = await scanFolder(folderPath, 1000, (text: string) => {
      uni.showLoading({ title: text, mask: true } as any)
    })
  } catch (e) {
    uni.hideLoading()
    uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
    return
  }
  uni.hideLoading()
  if (scan.files === 0) {
    uni.showToast({ title: '文件夹里没有可下载的文件', icon: 'none' })
    return
  }
  if (scan.truncated) {
    uni.showModal({
      title: '文件数量过多',
      content: '该文件夹（含子目录）超过 1000 个文件，为避免占满队列，请改用 DSM 端打包下载或分批处理。',
      showCancel: false,
    } as any)
    return
  }

  const begin = () => {
    const groupId = 'fd' + Date.now().toString()
    const groupName = folderPath.split('/').pop() ?? folderPath
    uni.showLoading({ title: '正在加入 0 / ' + scan.files.toString(), mask: false } as any)
    enqueueFolderDownloads(folderPath, groupId, groupName, 1000, (text: string) => {
      uni.showLoading({ title: text, mask: false } as any)
    }).then((r) => {
      uni.hideLoading()
      uni.showToast({ title: '已加入 ' + r.files.toString() + ' 个文件，可到传输中心查看', icon: 'none' })
    }).catch((e) => {
      uni.hideLoading()
      uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
    })
  }

  if (scan.files <= 50) {
    begin()
    return
  }
  uni.showModal({
    title: '确认批量下载',
    content: '共 ' + scan.files.toString() + ' 个文件 · 总大小约 ' + formatSize(scan.totalSize) + '，将分批加入下载队列（3 个并发）。确定开始？',
    success: (res) => {
      if (res.confirm) begin()
    },
  } as any)
}

/** 批量备份到本机 = 逐个加入下载队列（下载管理页可看进度） */
async function batchDownload() {
  const paths = selectedPaths.value.slice()
  if (paths.length === 0) return
  // 收集：文件直入批量列表；文件夹递归扫描统计后并入（一次确认）
  const direct: Array<DlBatchItem> = []
  const folders: Array<FileItem> = []
  let dirFiles = 0
  let dirSize = 0
  for (let i = 0; i < items.value.length; i++) {
    const it = items.value[i]
    if (paths.indexOf(it.path) < 0) continue
    if (it.isDir) {
      folders.push(it)
    } else {
      const item: DlBatchItem = { url: api.downloadFileUrl(it.path), name: it.name, nasPath: it.path }
      direct.push(item)
    }
  }
  for (let i = 0; i < folders.length; i++) {
    uni.showLoading({ title: '扫描目录中 ' + (i + 1).toString() + '/' + folders.length.toString(), mask: true } as any)
    try {
      const s = await scanFolder(folders[i].path, 1000, (text: string) => {
        uni.showLoading({ title: text, mask: true } as any)
      })
      dirFiles = dirFiles + s.files
      dirSize = dirSize + s.totalSize
    } catch (e) {
      uni.hideLoading()
      uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
      return
    }
  }
  uni.hideLoading()
  const totalCount = direct.length + dirFiles
  if (totalCount === 0) {
    uni.showToast({ title: '没有可下载的文件', icon: 'none' })
    return
  }
  if (dirFiles > 1000) {
    uni.showModal({
      title: '文件数量过多',
      content: '所选文件夹超过 1000 个文件，请改用 DSM 端打包下载或分批处理。',
      showCancel: false,
    } as any)
    return
  }

  const groupId = 'fd' + Date.now().toString()
  const groupName = folders.length === 1 ? folders[0].name : '多选 ' + folders.length.toString() + ' 个文件夹'
  const begin = () => {
    uni.showLoading({ title: '正在加入 0 / ' + totalCount.toString(), mask: false } as any)
    const seqPromise = (async () => {
      let totalAdded = startDownloadBatch(direct, groupId, groupName)
      for (let i = 0; i < folders.length; i++) {
        const r = await enqueueFolderDownloads(folders[i].path, groupId, groupName, 1000 - totalAdded, (text: string) => {
          uni.showLoading({ title: text, mask: false } as any)
        })
        totalAdded = totalAdded + r.files
      }
      return totalAdded
    })()
    seqPromise.then((added) => {
      uni.hideLoading()
      uni.showToast({ title: '已加入 ' + added.toString() + ' 个文件', icon: 'none' })
    }).catch((e) => {
      uni.hideLoading()
      uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
    })
    exitSelect()
  }

  if (totalCount <= 50) {
    begin()
    return
  }
  uni.showModal({
    title: '确认批量下载',
    content: '共 ' + totalCount.toString() + ' 个文件 · 总大小约 ' + formatSize(dirSize) + '，将分批加入下载队列。确定开始？',
    success: (res) => {
      if (res.confirm) begin()
    },
  } as any)
}

function batchMove(mode: string) {
  const paths = selectedPaths.value.slice()
  if (paths.length === 0) return
  pendingPaths = paths
  moveMode = mode
  pickerTitle.value = (mode === 'move' ? '移动到…（' : '复制到…（') + paths.length + ' 项）'
  pickerOpen.value = true
}

// ---------------- 排序 ----------------

const sortBy = ref('name')
const sortAsc = ref(true)
const sortHint = ref('')

function cmpName(a: string, b: string): number {
  const x = a.toLowerCase()
  const y = b.toLowerCase()
  const n = x.length < y.length ? x.length : y.length
  for (let i = 0; i < n; i++) {
    const rx = x.charCodeAt(i)
    const ry = y.charCodeAt(i)
    const cx: number = rx != null ? (rx as number) : 0
    const cy: number = ry != null ? (ry as number) : 0
    if (cx != cy) return cx - cy
  }
  return x.length - y.length
}

function applySort(list: Array<FileItem>): Array<FileItem> {
  const arr = list.slice()
  arr.sort((a: FileItem, b: FileItem): number => {
    // 文件夹永远排在文件前面
    if (a.isDir !== b.isDir) {
      return a.isDir ? -1 : 1
    }
    let cmp = 0
    if (sortBy.value === 'size') {
      cmp = a.size - b.size
    } else if (sortBy.value === 'time') {
      cmp = a.mtime - b.mtime
    } else {
      cmp = cmpName(a.name, b.name)
    }
    return sortAsc.value ? cmp : -cmp
  })
  return arr
}

function pickSort() {
  uni.showActionSheet({
    itemList: ['名称 ↑', '名称 ↓', '大小 ↑', '大小 ↓', '时间（旧→新）', '时间（新→旧）'],
    success: (res) => {
      const bys = ['name', 'name', 'size', 'size', 'time', 'time']
      const names = ['名称 ↑', '名称 ↓', '大小 ↑', '大小 ↓', '时间 ↑', '时间 ↓']
      sortBy.value = bys[res.tapIndex]
      sortAsc.value = res.tapIndex % 2 === 0
      sortHint.value = names[res.tapIndex]
      items.value = applySort(items.value)
    },
  })
}

// ---------------- 搜索 ----------------

const keyword = ref('')

function openSearch() {
  if (stack.value.length === 0) {
    uni.showToast({ title: '请先进入一个共享文件夹再搜索', icon: 'none' })
    return
  }
  uni.showModal({
    title: '搜索',
    editable: true,
    placeholderText: '文件名关键词（在当前共享内搜索）',
    success: async (res) => {
      if (!res.confirm) return
      const kw = res.content != null ? res.content.trim() : ''
      if (kw.length === 0) return
      await runSearch(kw)
    },
  })
}

/**
 * 搜索分两步：
 * 1) 先在当前目录已加载的列表里做关键词过滤 —— 立即出结果，不依赖 NAS 索引服务；
 * 2) 再向 NAS 发起全盘搜索（FileStation.Search），有结果就合并去重。
 * NAS 没开索引服务时第 2 步会返回空，此时第 1 步的结果仍然可用。
 */
async function runSearch(kw: string) {
  keyword.value = kw
  errorMsg.value = ''
  const lower = kw.toLowerCase()

  // 第 1 步：本地过滤（同步、即时）
  const local: Array<FileItem> = []
  for (let i = 0; i < rawItems.value.length; i++) {
    const it = rawItems.value[i]
    if (it.name.toLowerCase().indexOf(lower) >= 0) {
      local.push(it)
    }
  }
  items.value = applySort(local)

  // 第 2 步：全盘搜索（失败不影响本地结果）
  let taskid = ''
  try {
    const root = '/' + stack.value[0]
    taskid = await api.searchStart(root, kw)
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), 1000)
    })
    let remote: Array<FileItem> = []
    for (let page = 0; page < 10; page++) {
      const part = await api.searchList(taskid, page * 200, 200)
      if (part.length === 0) break
      remote = remote.concat(part)
      if (part.length < 200) break
    }
    if (remote.length > 0) {
      // 按 path 去重后合并
      const seen = new Map<string, boolean>()
      const merged: Array<FileItem> = []
      for (let i = 0; i < local.length; i++) {
        seen.set(local[i].path, true)
        merged.push(local[i])
      }
      for (let i = 0; i < remote.length; i++) {
        if (!seen.has(remote[i].path)) {
          seen.set(remote[i].path, true)
          merged.push(remote[i])
        }
      }
      items.value = applySort(merged)
    }
  } catch (e) {
    // 全盘搜索不可用（没装索引服务等）：保留本地过滤结果
  }
  if (taskid.length > 0) {
    try {
      await api.searchStop(taskid)
    } catch (e) {
      // 忽略
    }
  }
  if (items.value.length === 0) {
    uni.showToast({ title: '当前目录无匹配；全盘搜索需在 NAS 开启索引服务', icon: 'none' })
  }
}

function clearSearch() {
  keyword.value = ''
  items.value = rawItems.value
}

/** 长按文件夹「下载全部文件」：走两阶段流程（扫描 → 确认 → 分批入队） */
async function backupFolderToDevice(item: FileItem) {
  await downloadWholeFolder(item.path)
}

/** 按绝对路径重建目录栈 */
function jumpTo(absPath: string) {
  const parts = absPath.split('/')
  const next: Array<string> = []
  for (let i = 0; i < parts.length; i++) {
    if (parts[i].length > 0) next.push(parts[i])
  }
  keyword.value = ''
  stack.value = next
  refreshPath()
  items.value = []
  load()
}

function goUp() {
  if (stack.value.length === 0) return
  keyword.value = ''
  stack.value.pop()
  // 从 #recycle 退回共享根时，退出回收站视图（清空按钮、菜单都跟着复位）
  if (inRecycle.value && stack.value.length <= 1) {
    inRecycle.value = false
    recycleShare.value = ''
  }
  refreshPath()
  items.value = []
  load()
}

function downloadFile() {
  const item = actionItem.value
  actionItem.value = null
  if (item == null) return
  // 统一走下载队列：App 端后台下载并可在「下载管理」查看进度，Web 端交给浏览器
  startDownload(api.downloadFileUrl(item.path), item.name, item.path)
  // #ifdef WEB
  uni.showToast({ title: '已开始浏览器下载', icon: 'none' })
  // #endif
  // #ifndef WEB
  uni.showToast({ title: '已加入下载列表', icon: 'none' })
  // #endif
}

async function makeShareLink() {
  const item = actionItem.value
  if (item != null) {
    try {
      const link = await api.createShareLink(item.path)
      // #ifdef WEB
      window.prompt('共享链接：', link)
      // #endif
      // #ifndef WEB
      uni.setClipboardData({ data: link })
      uni.showToast({ title: '共享链接已复制', icon: 'none' })
      // #endif
    } catch (e) {
      uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
    }
  }
  actionItem.value = null
}

function deleteFile() {
  const item = actionItem.value
  actionItem.value = null
  if (item != null) {
    uni.showModal({
      title: '删除确认',
      content: '确定删除 ' + item.name + '？该操作不可撤销。',
      success: async (res) => {
        if (res.confirm) {
          try {
            await api.deleteFiles([item.path])
            load()
          } catch (e) {
            uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
          }
        }
      },
    })
  }
}

function createFolder() {
  uni.showModal({
    title: '新建文件夹',
    editable: true,
    placeholderText: '文件夹名称',
    success: async (res) => {
      if (res.confirm && res.content != null && res.content.length > 0) {
        try {
          await api.createFolder(currentPath.value, res.content)
          load()
        } catch (e) {
          uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
        }
      }
    },
  })
}
</script>

