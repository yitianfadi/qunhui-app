/**
 * qh-file-picker 类型定义
 * Android 端文件 / 文件夹选择（SAF，Storage Access Framework）
 */

/** 选中（或扫描到）的单个文件 */
export type PickedFile = {
  /** 文件名，如 IMG_0001.jpg */
  name: string
  /** 文件字节数，部分 provider 取不到时为 0 */
  size: number
  /** content:// URI，可直接交给 exportToCache 导出为本地文件 */
  uri: string
  /** 相对所选文件夹的路径，如 sub/a.jpg；选择单个文件时等于 name */
  relativePath: string
  /** MIME 类型，如 image/jpeg */
  mimeType: string
}

/** pickFiles 成功回调参数 */
export type PickedFilesResult = {
  errMsg: string
  files: Array<PickedFile>
}

/** pickDirectory 成功回调参数 */
export type PickedDirResult = {
  errMsg: string
  /** 所选文件夹的名称 */
  dirName: string
  /** 文件夹的 tree URI（已申请持久读权限） */
  treeUri: string
  /** 递归扫描到的全部文件 */
  files: Array<PickedFile>
  /** 全部文件合计字节数 */
  totalSize: number
  /** 是否因为超过 maxFiles 上限被截断 */
  truncated: boolean
}

/** pickFiles 参数 */
export type PickFilesOptions = {
  /** 最多可选数量，默认 20 */
  count?: number
  /** MIME 过滤，默认 *\/* 表示任意文件 */
  mimeType?: string
  success?: (res: PickedFilesResult) => void
  fail?: (res: UniError) => void
  complete?: (res: any) => void
}

/** pickDirectory 参数 */
export type PickDirectoryOptions = {
  /** 单次最多扫描的文件数，默认 2000，防止超大目录卡死 */
  maxFiles?: number
  success?: (res: PickedDirResult) => void
  fail?: (res: UniError) => void
  complete?: (res: any) => void
}

/** exportToCache 成功回调参数 */
export type ExportedFile = {
  errMsg: string
  /** 导出后的本地绝对路径，可直接用于 uni.uploadFile */
  path: string
  size: number
}

/** exportToCache 参数 */
export type ExportOptions = {
  /** pickFiles / pickDirectory 返回的 content:// URI */
  uri: string
  /** 保存到缓存目录时使用的文件名 */
  name: string
  success?: (res: ExportedFile) => void
  fail?: (res: UniError) => void
  complete?: (res: any) => void
}

/** clearCache 成功回调参数 */
export type ClearCacheResult = {
  errMsg: string
  /** 删除的文件个数 */
  removed: number
}

export type ClearCacheOptions = {
  success?: (res: ClearCacheResult) => void
  fail?: (res: UniError) => void
  complete?: (res: any) => void
}

/** nativeUpload 成功回调参数 */
export type NativeUploadResult = {
  errMsg: string
  /** HTTP 状态码 */
  statusCode: number
  /** 服务端响应正文（DSM 返回的 JSON 字符串） */
  data: string
}

/** nativeUpload 参数 */
export type NativeUploadOptions = {
  /** 完整请求地址（含 _sid 查询参数），如 http://nas:5000/webapi/entry.cgi?_sid=xxx */
  url: string
  /** DSM 会话 id，作为 Cookie: id=xxx 发送 */
  sid: string
  /** NAS 目标目录，如 /photo */
  destFolder: string
  /** 待上传文件的本地绝对路径 */
  filePath: string
  /** 保存到 NAS 上的文件名 */
  fileName: string
  /** 进度回调，percent 为 0~100（含写完文件但未收到响应前的 99） */
  onProgress?: (percent: number) => void
  success?: (res: NativeUploadResult) => void
  fail?: (res: UniError) => void
  complete?: (res: any) => void
}

/** 错误码 */
export type QhPickerErrorCode =
  9020001 | // 平台不支持
  9020002 | // 用户取消
  9020003 | // 未取到 URI
  9020004 | // 读取文件失败
  9020005 | // 无法启动选择器
  9020006 | // 没有权限
  9020007 | // 网络请求失败
  9020008 // 文件不存在

export interface QhPickerFail extends IUniError {
  errCode: QhPickerErrorCode
}

/** 选择文件（多选） */
export type PickFiles = (options: PickFilesOptions) => void
/** 选择文件夹并递归扫描其中的文件 */
export type PickDirectory = (options: PickDirectoryOptions) => void
/** 把 content:// 文件导出到应用缓存目录，返回本地路径 */
export type ExportFile = (options: ExportOptions) => void
/** 清空导出缓存目录 */
export type ClearCache = (options: ClearCacheOptions) => void
/**
 * 原生流式 multipart 上传（参数段在前、文件段最后）。
 *
 * 为什么不用 uni.uploadFile：它固定把「文件段」放在 multipart 最前面，
 * 而 DSM 的 SYNO.FileStation.Upload 要求参数段在前，文件段在前一律返回 101；
 * 且它无法给出可控的进度/取消。这里用 HttpURLConnection 边读边发，
 * 内存占用与文件大小无关，几百 MB 的视频也能传。
 */
export type NativeUpload = (options: NativeUploadOptions) => void
/** 中断正在进行的 nativeUpload（只保留最近一次任务） */
export type CancelNativeUpload = () => void
