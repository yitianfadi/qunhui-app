/**
 * qh-file-picker —— Android 原生文件 / 文件夹选择器
 *
 * 为什么需要它：uni-app x 只提供 uni.chooseImage（相册媒体），没有 chooseFile，
 * 也没有目录选择 API。这里直接用 Android 的 SAF（Storage Access Framework）实现：
 *   - pickFiles   → ACTION_OPEN_DOCUMENT（可多选、可指定 MIME）
 *   - pickDirectory → ACTION_OPEN_DOCUMENT_TREE（选整个文件夹）
 *   - 目录用 ContentResolver 递归查询（DocumentsContract），拿不到名字时降级
 *   - exportToCache → 把 content:// 流式拷贝到应用缓存，供 uni.uploadFile 上传
 */
import Activity from 'android.app.Activity'
import ContentResolver from 'android.content.ContentResolver'
import Intent from 'android.content.Intent'
import Uri from 'android.net.Uri'
import DocumentsContract from 'android.provider.DocumentsContract'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import InputStream from 'java.io.InputStream'
import HttpURLConnection from 'java.net.HttpURLConnection'
import URL from 'java.net.URL'
import OutputStreamWriter from 'java.io.OutputStreamWriter'
import FileInputStream from 'java.io.FileInputStream'
import BufferedReader from 'java.io.BufferedReader'
import InputStreamReader from 'java.io.InputStreamReader'
import Thread from 'java.lang.Thread'
import Runnable from 'java.lang.Runnable'
import Build from 'android.os.Build'
import Context from 'android.content.Context'
import NotificationManager from 'android.app.NotificationManager'
import NotificationChannel from 'android.app.NotificationChannel'
import PendingIntent from 'android.app.PendingIntent'
import NotificationCompat from 'androidx.core.app.NotificationCompat'
import BiometricManager from 'androidx.biometric.BiometricManager'
import BiometricPrompt from 'androidx.biometric.BiometricPrompt'
import FragmentActivity from 'androidx.fragment.app.FragmentActivity'
import Executors from 'java.util.concurrent.Executors'
import HttpsURLConnection from 'javax.net.ssl.HttpsURLConnection'
import SSLContext from 'javax.net.ssl.SSLContext'
import SSLSession from 'javax.net.ssl.SSLSession'
import X509TrustManager from 'javax.net.ssl.X509TrustManager'
import TrustManager from 'javax.net.ssl.TrustManager'
import HostnameVerifier from 'javax.net.ssl.HostnameVerifier'
import X509Certificate from 'java.security.cert.X509Certificate'
// Kotlin 原生数组类型（UTS Array 编译为 UTSArray，与系统 API 要求的 kotlin.Array 不兼容）
import KotlinArray from 'kotlin.Array'
// 生物识别回调：纯 Kotlin 混编实现，见同目录 BioNative.kt
import { BioNativeCallback } from './BioNative.kt'

import {
  PickFiles,
  PickFilesOptions,
  PickedFile,
  PickedFilesResult,
  PickDirectory,
  PickDirectoryOptions,
  PickedDirResult,
  ExportFile,
  ExportOptions,
  ExportedFile,
  ClearCache,
  ClearCacheOptions,
  ClearCacheResult,
  NativeUpload,
  CancelNativeUpload,
  NativeUploadProgress,
  NativeUploadOptions,
  NativeUploadResult,
  NotifyUploadDone,
  NotifyUploadOptions,
  BiometricAuth,
  BiometricAuthOptions,
  BiometricAvailable,
  SetTrustAllCerts
} from '../interface.uts'
import { QhPickerFailImpl } from '../unierror'

const REQ_PICK_FILES = 29801
const REQ_PICK_DIR = 29802
/** 缓存目录名（应用私有缓存，系统可随时清理） */
const CACHE_DIR_NAME = 'qh_pick'
/** DocumentsContract.Document.MIME_TYPE_DIR */
const MIME_DIR = 'vnd.android.document/directory'
/** 拷贝缓冲区大小（Kotlin 的 ByteArray 需要 Int，用 toInt() 转换） */
const BUF_SIZE = 65536

let pendingFiles: PickFilesOptions | null = null
let pendingDir: PickDirectoryOptions | null = null
let listenerReady = false

/** 目录遍历节点（避免递归，用栈做 BFS） */
class DirNode {
  docId: string = ''
  relPath: string = ''

  constructor(docId: string, relPath: string) {
    this.docId = docId
    this.relPath = relPath
  }
}

/** 注册一次 Activity 结果监听（插件内部复用） */
function ensureListener() {
  if (listenerReady) {
    return
  }
  listenerReady = true
  UTSAndroid.onAppActivityResult((requestCode: Int, resultCode: Int, data?: Intent) => {
    if (requestCode == REQ_PICK_FILES) {
      handleFilesResult(resultCode, data)
    } else if (requestCode == REQ_PICK_DIR) {
      handleDirResult(resultCode, data)
    }
  })
}

/** 查询单个 content uri 的显示名与大小 */
function queryMeta(resolver: ContentResolver, uri: Uri): PickedFile {
  let name = ''
  let size = 0
  const cursor = resolver.query(uri, null, null, null, null)
  if (cursor != null) {
    if (cursor.moveToFirst()) {
      const nameIdx = cursor.getColumnIndex('_display_name')
      if (nameIdx >= 0) {
        const v = cursor.getString(nameIdx)
        if (v != null) {
          name = v
        }
      }
      const sizeIdx = cursor.getColumnIndex('_size')
      if (sizeIdx >= 0) {
        size = cursor.getLong(sizeIdx)
      }
    }
    cursor.close()
  }
  const item: PickedFile = {
    name: name,
    size: size,
    uri: uri.toString(),
    relativePath: name,
    mimeType: ''
  }
  return item
}

/** 递归扫描 tree uri 下的全部文件 */
function collectTree(resolver: ContentResolver, treeUri: Uri, maxFiles: number): Array<PickedFile> {
  const out: Array<PickedFile> = []
  const rootId = DocumentsContract.getTreeDocumentId(treeUri)
  const stack: Array<DirNode> = []
  stack.push(new DirNode(rootId, ''))

  while (stack.length > 0) {
    if (out.length >= maxFiles) {
      break
    }
    const node = stack.pop()!
    const childrenUri = DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, node.docId)
    const cursor = resolver.query(childrenUri, null, null, null, null)
    if (cursor == null) {
      continue
    }
    const idIdx = cursor.getColumnIndex('document_id')
    const nameIdx = cursor.getColumnIndex('_display_name')
    const mimeIdx = cursor.getColumnIndex('mime_type')
    const sizeIdx = cursor.getColumnIndex('_size')

    while (cursor.moveToNext()) {
      if (out.length >= maxFiles) {
        break
      }
      let docId = ''
      if (idIdx >= 0) {
        const v = cursor.getString(idIdx)
        if (v != null) {
          docId = v
        }
      }
      let name = ''
      if (nameIdx >= 0) {
        const v = cursor.getString(nameIdx)
        if (v != null) {
          name = v
        }
      }
      let mime = ''
      if (mimeIdx >= 0) {
        const v = cursor.getString(mimeIdx)
        if (v != null) {
          mime = v
        }
      }
      if (docId.length == 0 || name.length == 0) {
        continue
      }
      const relPath = node.relPath.length == 0 ? name : node.relPath + '/' + name
      if (mime == MIME_DIR) {
        stack.push(new DirNode(docId, relPath))
      } else {
        let size = 0
        if (sizeIdx >= 0) {
          size = cursor.getLong(sizeIdx)
        }
        const docUri = DocumentsContract.buildDocumentUriUsingTree(treeUri, docId)
        const item: PickedFile = {
          name: name,
          size: size,
          uri: docUri.toString(),
          relativePath: relPath,
          mimeType: mime
        }
        out.push(item)
      }
    }
    cursor.close()
  }
  return out
}

function finishFiles(options: PickFilesOptions, files: Array<PickedFile>) {
  const res: PickedFilesResult = {
    errMsg: 'pickFiles:ok',
    files: files
  }
  options.success?.(res)
  options.complete?.(res)
}

function failFiles(options: PickFilesOptions, err: UniError) {
  options.fail?.(err)
  options.complete?.(err)
}

function finishDir(options: PickDirectoryOptions, dirName: string, treeUri: string,
  files: Array<PickedFile>, totalSize: number, truncated: boolean) {
  const res: PickedDirResult = {
    errMsg: 'pickDirectory:ok',
    dirName: dirName,
    treeUri: treeUri,
    files: files,
    totalSize: totalSize,
    truncated: truncated
  }
  options.success?.(res)
  options.complete?.(res)
}

function failDir(options: PickDirectoryOptions, err: UniError) {
  options.fail?.(err)
  options.complete?.(err)
}

/** 处理「选择文件」返回 */
function handleFilesResult(resultCode: Int, data?: Intent) {
  const options = pendingFiles
  pendingFiles = null
  if (options == null) {
    return
  }
  if (resultCode != Activity.RESULT_OK) {
    failFiles(options, new QhPickerFailImpl(9020002))
    return
  }
  const ctx = UTSAndroid.getAppContext()
  if (ctx == null || data == null) {
    failFiles(options, new QhPickerFailImpl(9020003))
    return
  }
  const resolver = ctx.getContentResolver()
  const files: Array<PickedFile> = []

  const clip = data.getClipData()
  if (clip != null) {
    for (let i = 0; i < clip.getItemCount(); i++) {
      const item = clip.getItemAt(i.toInt())
      const u = item.getUri()
      if (u != null) {
        files.push(queryMeta(resolver, u))
      }
    }
  }
  if (files.length == 0) {
    const single = data.getData()
    if (single != null) {
      files.push(queryMeta(resolver, single))
    }
  }
  if (files.length == 0) {
    failFiles(options, new QhPickerFailImpl(9020003))
    return
  }
  finishFiles(options, files)
}

/** 处理「选择文件夹」返回 */
function handleDirResult(resultCode: Int, data?: Intent) {
  const options = pendingDir
  pendingDir = null
  if (options == null) {
    return
  }
  if (resultCode != Activity.RESULT_OK) {
    failDir(options, new QhPickerFailImpl(9020002))
    return
  }
  const ctx = UTSAndroid.getAppContext()
  if (ctx == null || data == null) {
    failDir(options, new QhPickerFailImpl(9020003))
    return
  }
  const treeUri = data.getData()
  if (treeUri == null) {
    failDir(options, new QhPickerFailImpl(9020003))
    return
  }
  const resolver = ctx.getContentResolver()
  // 申请持久读权限，后续导出文件时仍可用
  try {
    resolver.takePersistableUriPermission(treeUri, Intent.FLAG_GRANT_READ_URI_PERMISSION.toInt())
  } catch (e) {
    // 部分 provider 不支持持久授权，忽略即可（本次会话内仍可读）
  }

  const maxFiles = options.maxFiles == null ? 2000 : options.maxFiles!
  const files = collectTree(resolver, treeUri, maxFiles)
  let total = 0
  for (let i = 0; i < files.length; i++) {
    total = total + files[i].size
  }
  const truncated = files.length >= maxFiles

  // 取文件夹名
  let dirName = ''
  try {
    const rootId = DocumentsContract.getTreeDocumentId(treeUri)
    const rootUri = DocumentsContract.buildDocumentUriUsingTree(treeUri, rootId)
    dirName = queryMeta(resolver, rootUri).name
  } catch (e) {
    dirName = ''
  }
  if (dirName.length == 0) {
    dirName = '已选文件夹'
  }
  finishDir(options, dirName, treeUri.toString(), files, total, truncated)
}

/** 选择文件（多选） */
export const pickFiles: PickFiles = function (options: PickFilesOptions) {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    failFiles(options, new QhPickerFailImpl(9020005))
    return
  }
  ensureListener()
  pendingFiles = options
  const count = options.count == null ? 20 : options.count!
  const mime = options.mimeType == null ? '*/*' : options.mimeType!
  const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT)
  intent.addCategory(Intent.CATEGORY_OPENABLE)
  intent.setType(mime)
  intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, count > 1)
  intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION.toInt())
  try {
    activity.startActivityForResult(intent, REQ_PICK_FILES.toInt())
  } catch (e) {
    pendingFiles = null
    failFiles(options, new QhPickerFailImpl(9020005))
  }
}

/** 选择文件夹（递归返回其中全部文件） */
export const pickDirectory: PickDirectory = function (options: PickDirectoryOptions) {
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    failDir(options, new QhPickerFailImpl(9020005))
    return
  }
  ensureListener()
  pendingDir = options
  const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE)
  intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION.toInt())
  try {
    activity.startActivityForResult(intent, REQ_PICK_DIR.toInt())
  } catch (e) {
    pendingDir = null
    failDir(options, new QhPickerFailImpl(9020005))
  }
}

/** 文件名安全化：去掉路径分隔符等非法字符 */
function safeName(name: string): string {
  let out = ''
  for (let i = 0; i < name.length; i++) {
    const c = name.charAt(i.toInt())
    if (c == '/' || c == '\\' || c == ':' || c == '*' || c == '?' || c == '"' || c == '<' || c == '>' || c == '|') {
      out = out + '_'
    } else {
      out = out + c
    }
  }
  if (out.length == 0) {
    out = 'file_' + Date.now()
  }
  return out
}

/** 把 content:// 文件流式导出到应用缓存目录 */
export const exportToCache: ExportFile = function (options: ExportOptions) {
  const ctx = UTSAndroid.getAppContext()
  if (ctx == null) {
    const err = new QhPickerFailImpl(9020004)
    options.fail?.(err)
    options.complete?.(err)
    return
  }
  let input: InputStream | null = null
  let output: FileOutputStream | null = null
  try {
    input = ctx.getContentResolver().openInputStream(Uri.parse(options.uri))
    if (input == null) {
      const err = new QhPickerFailImpl(9020006)
      options.fail?.(err)
      options.complete?.(err)
      return
    }
    const dir = new File(ctx.getCacheDir(), CACHE_DIR_NAME)
    if (!dir.exists()) {
      dir.mkdirs()
    }
    const outFile = new File(dir, safeName(options.name))
    output = new FileOutputStream(outFile)
    const buf = new ByteArray(BUF_SIZE.toInt())
    let len = input!.read(buf)
    while (len > 0) {
      output!.write(buf, 0, len.toInt())
      len = input!.read(buf)
    }
    output!.flush()
    output!.close()
    input!.close()

    const res: ExportedFile = {
      errMsg: 'exportToCache:ok',
      path: outFile.getAbsolutePath(),
      size: outFile.length()
    }
    options.success?.(res)
    options.complete?.(res)
  } catch (e) {
    try {
      if (output != null) {
        output!.close()
      }
      if (input != null) {
        input!.close()
      }
    } catch (e2) {
      // 忽略关闭异常
    }
    const err = new QhPickerFailImpl(9020004)
    options.fail?.(err)
    options.complete?.(err)
  }
}

/** 清空导出缓存目录 */
export const clearCache: ClearCache = function (options: ClearCacheOptions) {
  let removed = 0
  try {
    const ctx = UTSAndroid.getAppContext()
    if (ctx != null) {
      const dir = new File(ctx.getCacheDir(), CACHE_DIR_NAME)
      if (dir.exists()) {
        const nativeChildren = dir.listFiles()
        if (nativeChildren != null) {
          const children = Array.fromNative(nativeChildren)
          for (let i = 0; i < children.length; i++) {
            if (children[i].delete()) {
              removed = removed + 1
            }
          }
        }
      }
    }
    const res: ClearCacheResult = {
      errMsg: 'clearCache:ok',
      removed: removed
    }
    options.success?.(res)
    options.complete?.(res)
  } catch (e) {
    const err = new QhPickerFailImpl(9020004)
    options.fail?.(err)
    options.complete?.(err)
  }
}

// ---------------------------------------------------------------------------
// 原生流式 multipart 上传
// ---------------------------------------------------------------------------

/** 当前进行中的连接（同一时刻只保留一个上传任务） */
let activeConn: HttpURLConnection | null = null
/** 取消标记：置 true 后写文件循环会尽快退出 */
let activeAborted = false
/** 传给后台线程的任务参数 */
let pendingOptions: NativeUploadOptions | null = null
let pendingFile: File | null = null

/**
 * 当前上传进度（0-95 表示文件正文发送中，-1 表示没有进行中的任务）。
 *
 * 为什么要单独存一份：nativeUpload 在后台线程跑，实测从后台线程直接调用
 * JS 的 onProgress 回调**一次也到不了 JS**（界面永远停在 0%），
 * 因此改成由 JS 侧定时轮询这个值：每次轮询都是一次 JS→UTS 的同步调用，
 * 跨线程能看到最新写入。
 */
let upPercent: number = -1

/** 查询当前上传进度（0-100）；没有进行中的上传时返回 -1 —— 供 JS 轮询 */
export const nativeUploadProgress: NativeUploadProgress = function (): number {
  return upPercent
}

/** 中断正在进行的上传 */
export const cancelNativeUpload: CancelNativeUpload = function () {
  activeAborted = true
  const c = activeConn
  activeConn = null
  if (c != null) {
    try {
      c.disconnect()
    } catch (e) {
      // 连接可能已关闭，忽略
    }
  }
}

/**
 * 计算字符串按 UTF-8 编码后的字节数。
 * 用来算 multipart 的 Content-Length（不能直接用 String.length，中文算 3 字节）。
 */
function utf8Length(s: string): number {
  let n = 0
  let i = 0
  while (i < s.length) {
    const raw = s.charCodeAt(i)
    const c: number = raw != null ? (raw as number) : 0
    if (c < 0x80) {
      n = n + 1
    } else if (c < 0x800) {
      n = n + 2
    } else if (c >= 0xD800 && c <= 0xDBFF) {
      // 代理对（emoji 等）占 4 字节
      n = n + 4
      i = i + 1
    } else {
      n = n + 3
    }
    i = i + 1
  }
  return n
}

/** 后台线程的入口（Runnable 不能带构造参数，参数走模块级变量） */
class UploadRunnable extends Runnable {
  override run() {
    const o = pendingOptions
    const f = pendingFile
    pendingOptions = null
    pendingFile = null
    if (o == null || f == null) {
      return
    }
    doUpload(o, f)
  }
}

/** 真正干活：拼报文 → 边读边发 → 读响应 */
function doUpload(options: NativeUploadOptions, file: File) {
  let conn: HttpURLConnection | null = null
  let fin: FileInputStream | null = null
  try {
    const boundary = '----QunhuiBoundary' + Date.now().toString()
    const fileName = safeName(options.fileName)

    // 参数段必须排在文件段之前：DSM 收到「文件段在前」会直接返回 101
    let head = ''
    const fields: Array<Array<string>> = [
      ['api', 'SYNO.FileStation.Upload'],
      ['version', '2'],
      ['method', 'upload'],
      ['path', options.destFolder],
      ['create_parents', 'true'],
      ['overwrite', 'true']
    ]
    for (let i = 0; i < fields.length; i++) {
      head = head + '--' + boundary + '\r\n'
      head = head + 'Content-Disposition: form-data; name="' + fields[i][0] + '"\r\n\r\n'
      head = head + fields[i][1] + '\r\n'
    }
    head = head + '--' + boundary + '\r\n'
    head = head + 'Content-Disposition: form-data; name="file"; filename="' + fileName + '"\r\n'
    head = head + 'Content-Type: application/octet-stream\r\n\r\n'
    const tail = '\r\n--' + boundary + '--\r\n'

    const fileLen = file.length()
    const total = utf8Length(head) + utf8Length(tail) + fileLen.toDouble()
    upPercent = 0

    const u = new URL(options.url)
    const c = u.openConnection() as HttpURLConnection
    conn = c
    activeConn = c
    activeAborted = false
    c.setRequestMethod('POST')
    c.setDoOutput(true)
    c.setConnectTimeout(20000)
    c.setReadTimeout(1800000)
    c.setRequestProperty('Cookie', 'id=' + options.sid)
    c.setRequestProperty('Content-Type', 'multipart/form-data; boundary=' + boundary)
    c.setRequestProperty('User-Agent', 'QunHuiApp/1.0 (Android)')
    // 用定长模式：DSM 前面是 nginx，定长比 chunked 更稳，也不会一次性占内存
    c.setFixedLengthStreamingMode(total.toLong())
    c.connect()

    const out = c.getOutputStream()
    // head/tail 必须是 UTF-8 字节（文件名可能含中文），用 Writer 来做编码
    const writer = new OutputStreamWriter(out, 'UTF-8')
    writer.write(head)
    writer.flush()

    fin = new FileInputStream(file)
    const buf = new ByteArray(BUF_SIZE.toInt())
    let sent = 0
    let lastPercent = -1
    let len = fin.read(buf)
    while (len > 0) {
      if (activeAborted) {
        throw new Error('已取消上传')
      }
      out.write(buf, 0, len.toInt())
      sent = sent + len
      const cb = options.onProgress
      if (cb != null && total > 0) {
        // 文件正文占 0~95%，剩下的给收尾与响应
        let p = Math.floor((sent * 95) / total)
        if (p > 95) {
          p = 95
        }
        // 64KB 一块，200MB 会有 3200 次进度事件；只在百分比变化时更新
        if (p != lastPercent) {
          lastPercent = p
          upPercent = p
          cb(p)
        }
      }
      len = fin.read(buf)
    }
    fin.close()
    fin = null

    writer.write(tail)
    writer.flush()
    writer.close()

    const code = c.getResponseCode()
    let stream: InputStream | null = null
    if (code >= 400) {
      stream = c.getErrorStream()
    } else {
      stream = c.getInputStream()
    }
    let body = ''
    if (stream != null) {
      const reader = new BufferedReader(new InputStreamReader(stream, 'UTF-8'))
      let line = reader.readLine()
      while (line != null) {
        body = body + line + '\n'
        line = reader.readLine()
      }
      reader.close()
    }
    const doneCb = options.onProgress
    if (doneCb != null) {
      doneCb(100)
    }

    const res: NativeUploadResult = {
      errMsg: 'nativeUpload:ok',
      statusCode: code,
      data: body
    }
    options.success?.(res)
    options.complete?.(res)
  } catch (e) {
    const msg = e instanceof Error ? e.message : e.toString()
    const err = new QhPickerFailImpl(9020007)
    err.errMsg = '上传中断：' + msg
    options.fail?.(err)
    options.complete?.(err)
  } finally {
    if (fin != null) {
      try {
        fin!.close()
      } catch (e2) {
        // 忽略
      }
    }
    if (conn != null) {
      try {
        conn!.disconnect()
      } catch (e3) {
        // 忽略
      }
    }
    if (activeConn == conn) {
      activeConn = null
    }
    // 结束后复位：JS 侧轮询到 -1 就知道没有进行中的上传
    upPercent = -1
  }
}

/**
 * 原生流式上传：参数段在前、文件段最后，边读边发（内存与文件大小无关）。
 * 后台线程执行，进度通过 onProgress 回传，结果通过 success/fail 回传。
 */
export const nativeUpload: NativeUpload = function (options: NativeUploadOptions) {
  const f = new File(options.filePath)
  if (!f.exists()) {
    const err = new QhPickerFailImpl(9020008)
    options.fail?.(err)
    options.complete?.(err)
    return
  }
  if (!f.canRead()) {
    const err = new QhPickerFailImpl(9020006)
    options.fail?.(err)
    options.complete?.(err)
    return
  }
  pendingOptions = options
  pendingFile = f
  const t = new Thread(new UploadRunnable())
  t.start()
}

// ---------------------------------------------------------------------------
// 系统通知（备份完成提醒）
// ---------------------------------------------------------------------------

const CHANNEL_UPLOAD = 'qh_upload'
let notifySeq = 1000

/**
 * 发一条本地通知。通知权限未授予时静默跳过（不打扰用户）。
 * 通知点击后打开应用（取 getLaunchIntentForPackage）。
 */
export const notifyUploadDone: NotifyUploadDone = function (options: NotifyUploadOptions) {
  const ctx = UTSAndroid.getAppContext()
  if (ctx == null) {
    return
  }
  try {
    const nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    if (nm == null || !nm.areNotificationsEnabled()) {
      return
    }
    if (Build.VERSION.SDK_INT >= 26) {
      const ch = new NotificationChannel(CHANNEL_UPLOAD, '备份提醒', NotificationManager.IMPORTANCE_DEFAULT)
      nm.createNotificationChannel(ch)
    }
    const launch = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
    let pi: PendingIntent | null = null
    if (launch != null) {
      pi = PendingIntent.getActivity(ctx, 0, launch, PendingIntent.FLAG_IMMUTABLE)
    }
    const builder = new NotificationCompat.Builder(ctx, CHANNEL_UPLOAD)
    builder.setSmallIcon(ctx.getApplicationInfo().icon)
    builder.setContentTitle(options.title)
    builder.setContentText(options.content)
    // 长文本：失败原因可能较长，折叠前也能看清
    builder.setStyle(new NotificationCompat.BigTextStyle().bigText(options.content))
    builder.setAutoCancel(true)
    if (pi != null) {
      builder.setContentIntent(pi)
    }
    notifySeq = notifySeq + 1
    nm.notify(notifySeq.toInt(), builder.build())
  } catch (e) {
    // 通知失败不影响业务
  }
}

// ---------------------------------------------------------------------------
// 生物识别应用锁（androidx.biometric）
// ---------------------------------------------------------------------------

function biometricAvailableInternal(): boolean {
  const ctx = UTSAndroid.getAppContext()
  if (ctx == null) {
    return false
  }
  try {
    const bm = BiometricManager.from(ctx)
    return bm.canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_WEAK) == BiometricManager.BIOMETRIC_SUCCESS
  } catch (e) {
    return false
  }
}

/** 设备是否支持生物识别且已录入指纹/面容 */
export const isBiometricAvailable: BiometricAvailable = function (): boolean {
  return biometricAvailableInternal()
}

/** 弹出系统生物识别验证框（指纹/面容） */
export const biometricAuth: BiometricAuth = function (options: BiometricAuthOptions) {
  const act = UTSAndroid.getUniActivity()
  if (act == null) {
    options.fail?.(new QhPickerFailImpl(9020010))
    return
  }
  if (!biometricAvailableInternal()) {
    options.fail?.(new QhPickerFailImpl(9020009))
    return
  }
  // BioNativeCallback 为纯 Kotlin 混编实现（BioNative.kt）：
  // 云端转译器对 override(Int/CharSequence) 的映射与本地不一致，
  // UTS 版曾报 overrides nothing，故回调类下沉到原生 Kotlin
  const cb = new BioNativeCallback(
    () => {
      options.success?.()
    },
    (cancelled: boolean, msg: string) => {
      const err = new QhPickerFailImpl(cancelled ? 9020011 : 9020010)
      if (msg.length > 0) {
        err.errMsg = msg
      }
      options.fail?.(err)
    },
  )
  const fa = act as FragmentActivity
  const prompt = new BiometricPrompt(fa, Executors.newSingleThreadExecutor(), cb)
  const builder = new BiometricPrompt.PromptInfo.Builder()
  builder.setTitle(options.title)
  if (options.subtitle != null && options.subtitle!.length > 0) {
    builder.setSubtitle(options.subtitle!)
  }
  if (options.negativeText != null && options.negativeText!.length > 0) {
    builder.setNegativeButtonText(options.negativeText!)
  } else {
    builder.setNegativeButtonText('取消')
  }
  builder.setAllowedAuthenticators(BiometricManager.Authenticators.BIOMETRIC_WEAK)
  prompt.authenticate(builder.build())
}

// ---------------------------------------------------------------------------
// 自签 HTTPS 证书（仅影响本插件的 HttpURLConnection 上传通道）
// ---------------------------------------------------------------------------

class TrustAllManager extends X509TrustManager {
  // X509TrustManager 的方法签名要求 Kotlin 原生 Array（kotlin.Array），
  // UTS 的 Array 编译为 UTSArray，直接写会报 "overrides nothing"
  override checkClientTrusted(chain: KotlinArray<X509Certificate>, authType: string): void {
    // 信任所有客户端证书
  }
  override checkServerTrusted(chain: KotlinArray<X509Certificate>, authType: string): void {
    // 信任所有服务端证书（用户显式开启才生效）
  }
  override getAcceptedIssuers(): KotlinArray<X509Certificate> {
    const empty: Array<X509Certificate> = []
    return empty.toTypedArray()
  }
}

class TrustAllHostnames extends HostnameVerifier {
  override verify(hostname: string, session: SSLSession): boolean {
    return true
  }
}

/**
 * 开启后跳过 HTTPS 证书校验（自签名 NAS 场景）。
 * 只对 HttpsURLConnection 全局默认工厂生效 → 本插件的上传通道；
 * uni.request 的网络栈不归它管，设置页已注明这个局限。
 */
export const setTrustAllCerts: SetTrustAllCerts = function (enable: boolean) {
  try {
    if (!enable) {
      return
    }
    // SSLContext.init 要求 kotlin.Array<TrustManager!>，
    // 用 UTS 数组 + toTypedArray() 转换（不能直接用 UTS Array<X509TrustManager>）
    const list: Array<TrustManager> = []
    list.push(new TrustAllManager())
    const sc = SSLContext.getInstance('TLS')
    sc.init(null, list.toTypedArray(), null)
    HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory())
    HttpsURLConnection.setDefaultHostnameVerifier(new TrustAllHostnames())
  } catch (e) {
    // 初始化失败保持系统默认校验
  }
}
