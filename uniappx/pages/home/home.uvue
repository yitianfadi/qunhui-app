<template>
  <view class="page" :style="themeVars()">
    <!-- 内容区：用 v-show 保留各 tab 的状态（目录位置、滚动位置、已加载数据） -->
    <view class="content">
      <files-view v-show="tab === 0" />
      <photos-view v-show="tab === 1" />
      <transfer-view v-show="tab === 2" />
      <settings-view v-show="tab === 3" @logout="onLogout" />
    </view>

    <!-- 下载进行中浮条（点击进入下载管理） -->
    <dl-banner />

    <!-- 自定义底部导航 -->
    <view class="tabbar">
      <view v-for="(t, index) in tabs" :key="index" class="tab-item" @click="tab = index">
        <text class="tab-icon">{{ tab === index ? t.iconActive : t.icon }}</text>
        <text class="tab-label" :class="tab === index ? 'tab-label-active' : 'tab-label-normal'">{{ t.label }}</text>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onShow } from '@dcloudio/uni-app'
import { api } from '@/utils/syno.uts'
import { themeVars, initTheme } from '@/utils/theme.uts'
import { ensureUnlocked } from '@/utils/app_lock.uts'
import { restoreTrustCerts } from '@/utils/native_extra.uts'

const tab = ref(0)
const tabs = [
  { label: '文件', icon: '📁', iconActive: '📂' },
  { label: '照片', icon: '🖼️', iconActive: '🖼️' },
  { label: '传输', icon: '☁️', iconActive: '🔁' },
  { label: '设置', icon: '⚙️', iconActive: '⚙️' },
]

initTheme()
restoreTrustCerts()

// 未登录则回登录页
if (!api.loggedIn) {
  uni.reLaunch({ url: '/pages/login/login' })
}

// 应用锁：进入首页（含从后台返回）时需要生物识别验证
onShow(() => {
  ensureUnlocked()
})

function onLogout() {
  api.clear()
  uni.reLaunch({ url: '/pages/login/login' })
}
</script>

<style>
  .page {
    flex: 1;
    background-color: var(--bg);
  }
  .content {
    flex: 1;
  }
  .tabbar {
    height: 56px;
    flex-direction: row;
    background-color: var(--card);
    border-top: 1px solid var(--line);
  }
  .tab-item {
    flex: 1;
    align-items: center;
    justify-content: center;
  }
  .tab-icon {
    font-size: 18px;
  }
  .tab-label {
    font-size: 11px;
    margin-top: 2px;
  }
  .tab-label-active {
    color: var(--brand);
  }
  .tab-label-normal {
    color: var(--t3);
  }
</style>
