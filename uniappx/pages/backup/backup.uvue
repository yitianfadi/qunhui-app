<template>
  <view class="backup-page" :style="themeVars()">
    <!-- 顶部切换 -->
    <view class="seg-bar">
      <text class="seg-item" :class="mode === 'up' ? 'seg-active' : ''" @click="switchMode('up')">上传备份</text>
      <text class="seg-item" :class="mode === 'down' ? 'seg-active' : ''" @click="switchMode('down')">下载备份</text>
    </view>

    <!-- ============ 上传：手机 → NAS ============ -->
    <scroll-view v-if="mode === 'up'" class="body" direction="vertical">
      <view class="up-wrap">
        <view class="card">
          <text class="card-title">备份到 NAS 目录</text>
          <view class="path-row">
            <input class="path-input" v-model="destFolder" placeholder="/home 或 /photo" />
            <text class="path-pick" @click="openPicker('dest')">选择</text>
          </view>
          <text class="hint">点「选择」浏览 NAS 上已存在的共享文件夹（如 /home、/photo）。共享文件夹本身不能自动创建（子目录可以）。</text>

          <view class="opt-row" @click="pickConflictPolicy">
            <text class="opt-label">同名文件</text>
            <text class="opt-value">{{ conflictLabel }}</text>
            <text class="chevron">›</text>
          </view>
          <view class="opt-row" @click="toggleDateSubdir">
            <text class="opt-label">按日期建子目录</text>
            <text class="opt-value">{{ dateSubdir ? '开（如 /photo/2026-11-14）' : '关' }}</text>
            <text class="chevron">›</text>
          </view>
          <view class="opt-row" @click="toggleWifiOnly">
            <text class="opt-label">仅在 Wi-Fi 下上传</text>
            <text class="opt-value">{{ wifiOnly ? '开' : '关' }}</text>
            <text class="chevron">›</text>
          </view>
        </view>

        <!-- 非 Wi-Fi 时的暂停提示 -->
        <view v-if="netBlocked === true" class="net-tip">
          <text class="net-tip-text">当前不是 Wi-Fi，上传已暂停</text>
          <text class="net-tip-act" @click="allowCellularUploadNow">仍要继续</text>
        </view>

        <view class="action-card" @click="pickPhotos">
          <text class="action-icon">📷</text>
          <view class="action-info">
            <text class="action-title">备份手机照片 / 视频</text>
            <text class="action-sub">从相册多选，逐个上传到上面的目标目录</text>
          </view>
          <text class="chevron">›</text>
        </view>

        <view class="action-card" @click="pickFolderUp">
          <text class="action-icon">📁</text>
          <view class="action-info">
            <text class="action-title">备份手机文件夹（含子目录）</text>
            <text class="action-sub">选择整个目录递归上传，NAS 上保留原有目录结构</text>
          </view>
          <text class="chevron">›</text>
        </view>

        <view class="action-card" @click="pickAnyFiles">
          <text class="action-icon">📄</text>
          <view class="action-info">
            <text class="action-title">选择任意文件上传</text>
            <text class="action-sub">PDF / Word / 压缩包等，可多选</text>
          </view>
          <text class="chevron">›</text>
        </view>

        <view class="note-card">
          <text class="note-text">
            前两项使用系统文件选择器，需在 Android App 中使用（Web 预览不支持）；上传前会把文件临时导出到应用缓存，传完自动清理。
          </text>
        </view>

        <!-- 上传队列 -->
        <view v-if="upTasks.length > 0" class="queue-head">
          <text class="queue-title">上传队列 {{ upTasks.length }}</text>
          <text v-if="failedUpCount > 0" class="queue-clear" @click="retryAllFailed">重试失败 {{ failedUpCount }}</text>
          <text class="queue-clear queue-clear-gap" @click="cancelUpAll">全部取消</text>
          <text class="queue-clear queue-clear-gap" @click="clearUp">清空已结束</text>
        </view>
        <view v-if="upTasks.length > recentUp.length" class="queue-note">
          <text class="queue-note-text">任务较多，仅显示最近 {{ recentUp.length }} 条；其余会按顺序继续上传</text>
        </view>

        <view v-for="(t, index) in recentUp" :key="t.id" class="task">
          <view class="task-head">
            <text class="task-icon">📤</text>
            <view class="task-main">
              <text class="task-name" max-lines="1">{{ t.name }}</text>
              <text class="task-meta">{{ t.timeText }} · {{ upStatusText(t) }}</text>
            </view>
            <text v-if="isUpActive(t) === true" class="task-act task-act-danger" @click="cancelUp(t.id)">取消</text>
            <text v-else class="task-act task-act-primary" @click="retryUp(t.id)">重试</text>
          </view>
          <view v-if="t.status === 'uploading'" class="bar">
            <view class="bar-in" :style="'width:' + t.percent + '%'" />
          </view>
          <view class="task-foot">
            <text v-if="t.status === 'failed'" class="task-err" max-lines="1">{{ t.error }}</text>
            <text v-else class="task-size">{{ t.sizeText }}</text>
            <text class="task-del" @click="removeUp(t.id)">删除记录</text>
          </view>
        </view>

        <view v-if="upTasks.length === 0" class="empty-box">
          <text class="empty-icon">📤</text>
          <text class="empty-title">还没有上传任务</text>
          <text class="empty-hint">选择手机相册里的照片或视频，即可备份到 NAS</text>
        </view>
      </view>
      <view class="bottom-space" />
    </scroll-view>

    <scroll-view v-else class="body" direction="vertical">
      <!-- 下载：NAS → 手机 -->
      <view class="down-wrap">
        <view class="card">
          <text class="card-title">选择要备份的文件夹</text>
          <view class="path-row" @click="openPicker('src')">
            <text class="path-value" max-lines="1">{{ srcFolder }}</text>
            <text class="path-pick">选择</text>
            <text class="chevron">›</text>
          </view>
          <view class="run-btn" :class="busy ? 'run-btn-off' : ''" @click="doBackupFolder">
            <text class="run-btn-text">{{ busy ? '处理中…' : '备份此文件夹到本机' }}</text>
          </view>
          <text v-if="busyText.length > 0" class="busy-text">{{ busyText }}</text>
        </view>

        <view class="action-card" @click="doBackupPhotos(false)">
          <text class="action-icon">🖼️</text>
          <view class="action-info">
            <text class="action-title">备份全部照片（个人空间）</text>
            <text class="action-sub">按时间线拉取，加入下载队列</text>
          </view>
          <text class="chevron">›</text>
        </view>

        <view class="action-card" @click="doBackupPhotos(true)">
          <text class="action-icon">🖼️</text>
          <view class="action-info">
            <text class="action-title">备份全部照片（共享空间）</text>
            <text class="action-sub">团队成员共享的照片</text>
          </view>
          <text class="chevron">›</text>
        </view>

        <view class="note-card">
          <text class="note-text">文件数量不限制，选中后按队列逐个上传；每个文件只在轮到它时才复制一份临时副本到手机缓存，传完即删，不会一次占满存储。可随时取消单个任务或全部取消。</text>
        </view>

        <!-- 最近下载任务 -->
        <view class="queue-head">
          <text class="queue-title">下载队列 {{ dlTasks.length }}</text>
          <text class="queue-clear" @click="openDownloadPage">查看全部 ›</text>
        </view>

        <view v-for="(t, index) in recentDl" :key="t.id" class="task">
          <view class="task-head">
            <text class="task-icon">📥</text>
            <view class="task-main">
              <text class="task-name" max-lines="1">{{ t.name }}</text>
              <text class="task-meta">{{ t.timeText }} · {{ dlStatusText(t) }}</text>
            </view>
          </view>
          <view v-if="t.status === 'downloading'" class="bar">
            <view class="bar-in" :style="'width:' + t.percent + '%'" />
          </view>
        </view>

        <view v-if="dlTasks.length === 0" class="empty-box">
          <text class="empty-icon">📥</text>
          <text class="empty-title">还没有下载任务</text>
          <text class="empty-hint">选择文件夹或照片空间开始备份</text>
        </view>
      </view>
      <view class="bottom-space" />
    </scroll-view>

    <!-- 文件夹选择器（按需挂载，避免根节点条件渲染） -->
    <folder-picker
      v-if="pickerFor.length > 0"
      :title="pickerTitle"
      @select="onPicked"
      @close="pickerFor = ''"
    />
  </view>
</template>

<script setup>
import { ref, computed, watch } from 'vue'
import { themeVars } from '@/utils/theme.uts'
import { upTaskList, startUpload, startUploadsBatch, cancelUpTask, removeUpTask, clearFinishedUpTasks, retryUpTask, cancelAllUpTasks, retryAllFailedUpTasks, getConflictPolicy, setConflictPolicy, getDateSubdir, setDateSubdir, getWifiOnly, setWifiOnly, upNetworkBlocked, allowCellularUpload, UpTask, UploadRequest } from '@/utils/upload_manager.uts'
import { dlTaskList, DlTask } from '@/utils/download_manager.uts'
import { backupFolder, backupPhotos } from '@/utils/backup_helper.uts'
import { formatSize } from '@/utils/syno.uts'
import { devicePickerSupported, devicePickDirectory, devicePickFiles, deviceClearCache, ensureMediaReadPermission, openAppAuthorizeSetting, DeviceDir, DeviceFile } from '@/utils/device_picker.uts'

const maxPick = 100000

const mode = ref('up')

// 记住上次使用的目录
let initialDest = '/home'
let initialSrc = '/photo'
try {
  const d = uni.getStorageSync('backup_dest')
  if (typeof d === 'string' && (d as string).length > 0) initialDest = d as string
  const s = uni.getStorageSync('backup_src')
  if (typeof s === 'string' && (s as string).length > 0) initialSrc = s as string
} catch (e) {
  // 忽略存储异常
}

// 历史默认值是 /backup —— 该共享文件夹在 DSM 上并不存在（上传会报 408），自动纠正
if (initialDest === '/backup') {
  initialDest = '/home'
}

const destFolder = ref(initialDest)
const srcFolder = ref(initialSrc)
const busy = ref(false)
const busyText = ref('')

// 文件夹选择器：''=关闭 / dest=选备份目标 / src=选要备份的源文件夹
const pickerFor = ref('')
const pickerTitle = computed(() =>
  pickerFor.value === 'dest' ? '选择备份目标文件夹' : '选择要备份的文件夹'
)

function openPicker(which: string) {
  pickerFor.value = which
}

function onPicked(path: string) {
  if (pickerFor.value === 'dest') {
    destFolder.value = path
  } else {
    srcFolder.value = path
  }
  pickerFor.value = ''
  savePaths()
}

function savePaths() {
  try {
    uni.setStorageSync('backup_dest', destFolder.value)
    uni.setStorageSync('backup_src', srcFolder.value)
  } catch (e) {
    // 忽略存储异常
  }
}

// ---------------- 上传选项 ----------------

const conflictPolicy = ref(getConflictPolicy())
const conflictLabel = computed(() => {
  const p = conflictPolicy.value
  if (p === 'skip') return '跳过（保留 NAS 上的）'
  if (p === 'rename') return '自动重命名'
  return '覆盖（默认）'
})

function pickConflictPolicy() {
  uni.showActionSheet({
    itemList: ['覆盖同名文件', '跳过（保留 NAS 上的）', '自动重命名（xxx (1).mp4）'],
    success: (res) => {
      let v = 'overwrite'
      if (res.tapIndex === 1) v = 'skip'
      if (res.tapIndex === 2) v = 'rename'
      conflictPolicy.value = v
      setConflictPolicy(v)
    },
    fail: () => {
      // 用户取消
    },
  })
}

const dateSubdir = ref(getDateSubdir())

function toggleDateSubdir() {
  dateSubdir.value = !dateSubdir.value
  setDateSubdir(dateSubdir.value)
}

const wifiOnly = ref(getWifiOnly())

function toggleWifiOnly() {
  wifiOnly.value = !wifiOnly.value
  setWifiOnly(wifiOnly.value)
}

// 网络被拦是模块级 ref，这里镜像一份，避免模板对导入 ref 的解包差异
const netBlocked = ref(false)
watch(
  upNetworkBlocked,
  (v: boolean) => {
    netBlocked.value = v
  },
  { immediate: true }
)

function allowCellularUploadNow() {
  allowCellularUpload()
}

function retryAllFailed() {
  const n = retryAllFailedUpTasks()
  uni.showToast({ title: '已重新加入 ' + n + ' 个', icon: 'none' })
}

// 用本地 ref 镜像队列：避免模板对「导入 ref 的局部别名」解包差异（App 端更稳）
const upTasks = ref<Array<UpTask>>([])
// 失败任务数（用于队列头的「重试失败 N」）
const failedUpCount = computed(() => {
  let n = 0
  for (let i = 0; i < upTasks.value.length; i++) {
    if (upTasks.value[i].status === 'failed') n = n + 1
  }
  return n
})
// 大批量任务时只渲染最近的若干条，避免上千行同时渲染卡住列表
const RENDER_LIMIT = 120
const recentUp = ref<Array<UpTask>>([])
const dlTasks = ref<Array<DlTask>>([])
// 只展示最近的 6 条下载任务
const recentDl = ref<Array<DlTask>>([])

watch(
  upTaskList,
  (v: Array<UpTask>) => {
    upTasks.value = v
    recentUp.value = v.slice(0, RENDER_LIMIT)
  },
  { immediate: true }
)

watch(
  dlTaskList,
  (v: Array<DlTask>) => {
    dlTasks.value = v
    recentDl.value = v.slice(0, 6)
  },
  { immediate: true }
)

function switchMode(m: string) {
  mode.value = m
}

function isUpActive(t: UpTask): boolean {
  return t.status === 'waiting' || t.status === 'uploading'
}

function upStatusText(t: UpTask): string {
  if (t.status === 'waiting') return '等待中'
  if (t.status === 'uploading') return '上传中 ' + t.percent + '%'
  if (t.status === 'done') return '已完成'
  if (t.status === 'canceled') return '已取消'
  return '上传失败'
}

function dlStatusText(t: DlTask): string {
  if (t.status === 'waiting') return '等待中'
  if (t.status === 'downloading') return '下载中 ' + t.percent + '%'
  if (t.status === 'done') return '已完成'
  if (t.status === 'canceled') return '已取消'
  return '下载失败'
}

/** 从本地路径推断文件名；content:// 或无扩展名时按类型+时间戳命名 */
function fileNameFromPath(p: string, idx: number, fileType: string): string {
  let name = ''
  const parts = p.split('/')
  if (parts.length > 0) name = parts[parts.length - 1]
  const qi = name.indexOf('?')
  if (qi > 0) name = name.slice(0, qi)
  // content://media/external/images/media/1000000033 这类末尾只是数字，没有扩展名
  const usable = name.length > 0 && name.indexOf('.') > 0 && name.indexOf(':') < 0 && !name.startsWith('image:')
  if (usable) return name
  const isVideo = fileType === 'video'
  const d = new Date()
  return (isVideo ? 'VID_' : 'IMG_') + d.getTime() + '_' + idx + (isVideo ? '.mp4' : '.jpg')
}

function pickPhotos() {
  const dest = destFolder.value.trim().length > 0 ? destFolder.value.trim() : '/home'
  destFolder.value = dest
  savePaths()
  // 先申请相册读取权限：没有权限时即使能选中，读原图也会 EACCES（Permission denied）
  // 只有「用户明确拒绝且不再询问」才会进入提示分支；已授权/状态读不到都直接放行
  ensureMediaReadPermission().then((ok: boolean) => {
    if (!ok) {
      uni.showModal({
        title: '未获得相册权限',
        content: '可以点「去设置」开启照片和视频权限；也可以改用下面的「选择任意文件上传」，那条路不需要相册权限。',
        confirmText: '去设置',
        cancelText: '取消',
        success: (res) => {
          if (res.confirm) {
            openAppAuthorizeSetting()
          }
        },
      })
      return
    }
    openMediaPicker(dest)
  })
}

/** App 端优先用 chooseMedia（图片+视频一次选完）；模块缺失时让用户二选一 */
function openMediaPicker(dest: string) {
  // #ifdef APP-ANDROID
  let started = false
  try {
    uni.chooseMedia({
      count: 50,
      mediaType: ['mix'],
      sizeType: ['original'],
      sourceType: ['album', 'camera'],
      success: (res) => {
        const files = res.tempFiles
        for (let i = 0; i < files.length; i++) {
          const f = files[i]
          const type = typeof f.fileType === 'string' ? f.fileType : 'image'
          startUpload(f.tempFilePath, fileNameFromPath(f.tempFilePath, i, type), dest)
        }
        uni.showToast({ title: '已加入 ' + files.length + ' 项', icon: 'none' })
      },
      fail: (err: any) => {
        if (err.errCode === 1101001) {
          return // 用户取消
        }
        chooseSourceThen(dest)
      },
    } as any)
    started = true
  } catch (e) {
    started = false
  }
  if (!started) {
    chooseSourceThen(dest)
  }
  // #endif
  // #ifndef APP-ANDROID
  pickImageOnly(dest)
  // #endif
}

/**
 * chooseMedia 不可用（基座没打进 uni-chooseMedia 模块）时的兜底菜单。
 * 视频走系统文件选择器（SAF），不依赖任何存储权限。
 */
function chooseSourceThen(dest: string) {
  if (!devicePickerSupported()) {
    pickImageOnly(dest)
    return
  }
  uni.showActionSheet({
    itemList: ['从相册选图片', '选视频文件'],
    success: (res) => {
      if (res.tapIndex === 1) {
        pickVideos(dest)
      } else {
        pickImageOnly(dest)
      }
    },
    fail: () => {
      // 用户取消就不做任何事
    },
  })
}

/** 用系统文件选择器选视频（SAF，多选），走 content:// → 缓存 → 上传 */
function pickVideos(dest: string) {
  uni.showLoading({ title: '打开选择器…', mask: true })
  devicePickFiles(50, 'video/*')
    .then((list: DeviceFile[]) => {
      uni.hideLoading()
      if (list.length === 0) {
        return
      }
      const reqs: Array<UploadRequest> = []
      for (let i = 0; i < list.length; i++) {
        const f = list[i]
        const req: UploadRequest = {
          localPath: '',
          contentUri: f.uri,
          name: f.name,
          destFolder: dest,
        }
        reqs.push(req)
      }
      const n = startUploadsBatch(reqs)
      uni.showToast({ title: '已加入 ' + n + ' 个视频', icon: 'none' })
    })
    .catch((e: any) => {
      uni.hideLoading()
      const msg = e instanceof Error ? e.message : String(e)
      uni.showToast({ title: '选择失败：' + msg, icon: 'none' })
    })
}

function pickImageOnly(dest: string) {
  uni.chooseImage({
    count: 50,
    sizeType: ['original'],
    sourceType: ['album', 'camera'],
    success: (res) => {
      const paths = res.tempFilePaths
      for (let i = 0; i < paths.length; i++) {
        startUpload(paths[i], fileNameFromPath(paths[i], i, 'image'), dest)
      }
      uni.showToast({ title: '已加入 ' + paths.length + ' 项', icon: 'none' })
    },
    fail: (err) => {
      if (err.errCode !== 1101001) {
        uni.showToast({ title: '选择失败：' + err.errMsg, icon: 'none' })
      }
    },
  })
}

// ---------- 手机端文件夹 / 任意文件上传（UTS 原生插件 qh-file-picker） ----------

function baseName(p: string): string {
  const i = p.lastIndexOf('/')
  return i >= 0 ? p.substring(i + 1) : p
}

function dirOf(p: string): string {
  const i = p.lastIndexOf('/')
  return i > 0 ? p.substring(0, i) : ''
}

function joinFolder(base: string, sub: string): string {
  let b = base
  while (b.length > 1 && b.charAt(b.length - 1) === '/') {
    b = b.substring(0, b.length - 1)
  }
  if (sub.length === 0) {
    return b
  }
  return b + '/' + sub
}

function normalizeDest(): string {
  const dest = destFolder.value.trim().length > 0 ? destFolder.value.trim() : '/home'
  destFolder.value = dest
  savePaths()
  return dest
}

function unsupportedTip() {
  uni.showModal({
    title: '需要 Android App',
    content: '系统文件选择器只在 Android App 中可用。Web 预览请用「备份手机照片 / 视频」，或改用下载备份。',
    showCancel: false,
  })
}

function pickFolderUp() {
  if (!devicePickerSupported()) {
    unsupportedTip()
    return
  }
  const dest = normalizeDest()
  // 清掉上一批残留的临时文件
  deviceClearCache()
  uni.showLoading({ title: '打开文件夹…', mask: true })
  devicePickDirectory(maxPick)
    .then((dir: DeviceDir) => {
      uni.hideLoading()
      if (dir.files.length === 0) {
        uni.showToast({ title: '该文件夹内没有文件', icon: 'none' })
        return
      }
      const tip = dir.truncated ? '\n超过单次上限 ' + maxPick + ' 个，已截断' : ''
      uni.showModal({
        title: '确认上传',
        content: '文件夹：' + dir.dirName + '\n文件数：' + dir.files.length + ' 个\n合计：' + formatSize(dir.totalSize) + tip,
        confirmText: '开始上传',
        cancelText: '取消',
        success: (r) => {
          if (!r.confirm) {
            return
          }
          enqueueFolder(dir, dest)
        },
      })
    })
    .catch((e: any) => {
      uni.hideLoading()
      const msg = e instanceof Error ? e.message : String(e)
      if (msg.indexOf('已取消') < 0) {
        uni.showToast({ title: msg, icon: 'none' })
      }
    })
}

function enqueueFolder(dir: DeviceDir, dest: string) {
  // 一次性批量入队（几千个文件时避免逐条插入的开销）
  const reqs: Array<UploadRequest> = []
  for (let i = 0; i < dir.files.length; i++) {
    const f = dir.files[i]
    const name = baseName(f.relativePath)
    if (name.length === 0) {
      continue
    }
    const req: UploadRequest = {
      localPath: '',
      contentUri: f.uri,
      name: name,
      destFolder: joinFolder(dest, dirOf(f.relativePath)),
    }
    reqs.push(req)
  }
  const n = startUploadsBatch(reqs)
  uni.showToast({ title: '已加入 ' + n + ' 个文件，开始排队上传', icon: 'none' })
}

function pickAnyFiles() {
  if (!devicePickerSupported()) {
    unsupportedTip()
    return
  }
  const dest = normalizeDest()
  uni.showLoading({ title: '打开文件选择器…', mask: true })
  devicePickFiles(20, '*/*')
    .then((files: Array<DeviceFile>) => {
      uni.hideLoading()
      if (files.length === 0) {
        return
      }
      const reqs: Array<UploadRequest> = []
      for (let i = 0; i < files.length; i++) {
        const f = files[i]
        if (f.name.length === 0) {
          continue
        }
        const req: UploadRequest = {
          localPath: '',
          contentUri: f.uri,
          name: f.name,
          destFolder: dest,
        }
        reqs.push(req)
      }
      const n = startUploadsBatch(reqs)
      uni.showToast({ title: '已加入 ' + n + ' 个文件，开始排队上传', icon: 'none' })
    })
    .catch((e: any) => {
      uni.hideLoading()
      const msg = e instanceof Error ? e.message : String(e)
      if (msg.indexOf('已取消') < 0) {
        uni.showToast({ title: msg, icon: 'none' })
      }
    })
}

function cancelUp(id: string) {
  cancelUpTask(id)
}

function retryUp(id: string) {
  retryUpTask(id)
}

function removeUp(id: string) {
  removeUpTask(id)
}

function clearUp() {
  clearFinishedUpTasks()
  uni.showToast({ title: '已清理结束的任务', icon: 'none' })
}

/** 取消全部进行中/排队中的上传 */
function cancelUpAll() {
  const n = cancelAllUpTasks()
  uni.showToast({
    title: n > 0 ? '已取消 ' + n + ' 个任务' : '没有进行中的任务',
    icon: 'none',
  })
}

async function doBackupFolder() {
  if (busy.value) return
  const p = srcFolder.value.trim()
  if (p.length === 0) {
    uni.showToast({ title: '请输入 NAS 文件夹路径', icon: 'none' })
    return
  }
  busy.value = true
  busyText.value = '正在扫描目录…'
  savePaths()
  try {
    const r = await backupFolder(p, maxPick, (text) => {
      busyText.value = text
    })
    busyText.value = ''
    uni.showToast({ title: '已加入 ' + r.files + ' 个文件', icon: 'none' })
    if (r.truncated) {
      uni.showModal({
        title: '已达单次上限',
        content: '单次最多备份 ' + maxPick + ' 个文件，剩余文件请分批备份。',
        showCancel: false,
      })
    }
  } catch (e) {
    busyText.value = ''
    uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
  } finally {
    busy.value = false
  }
}

async function doBackupPhotos(shared: boolean) {
  if (busy.value) return
  busy.value = true
  busyText.value = '正在读取照片列表…'
  try {
    const r = await backupPhotos(shared, maxPick, (text) => {
      busyText.value = text
    })
    busyText.value = ''
    if (r.files === 0) {
      uni.showToast({ title: '该空间没有可备份的照片', icon: 'none' })
    } else {
      uni.showToast({ title: '已加入 ' + r.files + ' 张照片', icon: 'none' })
    }
    if (r.truncated) {
      uni.showModal({
        title: '已达单次上限',
        content: '单次最多备份 ' + maxPick + ' 个文件，剩余照片请分批备份。',
        showCancel: false,
      })
    }
  } catch (e) {
    busyText.value = ''
    uni.showToast({ title: e instanceof Error ? e.message : String(e), icon: 'none' })
  } finally {
    busy.value = false
  }
}

function openDownloadPage() {
  uni.navigateTo({ url: '/pages/downloads/downloads' })
}
</script>

