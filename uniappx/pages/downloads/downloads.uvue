<template>
  <view class="dl-page">
    <!-- 概览条 -->
    <view class="summary">
      <view class="sum-left">
        <text class="sum-title">下载任务</text>
        <text class="sum-sub">{{ activeCount }} 个进行中 · 已完成 {{ doneCount }}</text>
      </view>
      <text v-if="finishedCount > 0" class="sum-clear" @click="clearFinished">清空已结束</text>
    </view>

    <scroll-view class="list" direction="vertical">
      <view v-for="(t, index) in tasks" :key="t.id" class="task">
        <view class="task-head">
          <text class="task-icon">{{ iconOf(t.name) }}</text>
          <view class="task-main">
            <text class="task-name" max-lines="1">{{ t.name }}</text>
            <text class="task-meta">{{ t.timeText }} · {{ statusText(t) }}</text>
          </view>
          <text v-if="isActive(t) === true" class="task-act task-act-danger" @click="cancelTask(t.id)">取消</text>
          <text v-else-if="t.status === 'done'" class="task-act task-act-primary" @click="openTask(t)">打开</text>
          <text v-else class="task-act task-act-primary" @click="retryTask(t.id)">重试</text>
        </view>

        <view v-if="t.status === 'downloading'" class="bar">
          <view class="bar-in" :style="'width:' + t.percent + '%'" />
        </view>

        <view class="task-foot">
          <text v-if="t.status === 'failed'" class="task-err" max-lines="1">{{ t.error }}</text>
          <text v-else class="task-size">{{ t.sizeText }}</text>
          <text class="task-del" @click="removeTask(t.id)">删除记录</text>
        </view>
      </view>

      <view v-if="tasks.length === 0" class="empty-box">
        <text class="empty-icon">📥</text>
        <text class="empty-title">暂无下载任务</text>
        <text class="empty-hint">在「文件」或「照片」页选择下载到本机后，任务会显示在这里</text>
      </view>

      <view class="bottom-space" />
    </scroll-view>
  </view>
</template>

<script setup>
import { computed } from 'vue'
import {
  dlTaskList,
  dlActiveCount,
  dlDoneCount,
  cancelDlTask,
  removeDlTask,
  clearFinishedDlTasks,
  retryDlTask,
  DlTask,
} from '@/utils/download_manager.uts'

// 局部别名：模板中自动解包 ref
const tasks = dlTaskList

const activeCount = computed(() => dlActiveCount())
const doneCount = computed(() => dlDoneCount())
const finishedCount = computed(() => {
  let n = 0
  for (let i = 0; i < tasks.value.length; i++) {
    const s = tasks.value[i].status
    if (s !== 'waiting' && s !== 'downloading') n = n + 1
  }
  return n
})

function isActive(t: DlTask): boolean {
  return t.status === 'waiting' || t.status === 'downloading'
}

function statusText(t: DlTask): string {
  if (t.status === 'waiting') return '等待中'
  if (t.status === 'downloading') return '下载中 ' + t.percent + '%'
  if (t.status === 'done') return '已完成'
  if (t.status === 'canceled') return '已取消'
  return '下载失败'
}

function iconOf(name: string): string {
  const n = name.toLowerCase()
  if (n.indexOf('.mp4') >= 0 || n.indexOf('.mkv') >= 0 || n.indexOf('.mov') >= 0 || n.indexOf('.avi') >= 0) return '🎬'
  if (n.indexOf('.jpg') >= 0 || n.indexOf('.jpeg') >= 0 || n.indexOf('.png') >= 0 || n.indexOf('.heic') >= 0) return '🖼️'
  if (n.indexOf('.zip') >= 0 || n.indexOf('.rar') >= 0 || n.indexOf('.7z') >= 0) return '🗜️'
  if (n.indexOf('.pdf') >= 0) return '📕'
  if (n.indexOf('.mp3') >= 0 || n.indexOf('.flac') >= 0 || n.indexOf('.wav') >= 0) return '🎵'
  return '📄'
}

function openTask(t: DlTask) {
  if (t.savedPath.length === 0) {
    uni.showToast({ title: '文件不存在', icon: 'none' })
    return
  }
  // #ifdef WEB
  uni.showToast({ title: '请在浏览器下载记录中查看', icon: 'none' })
  // #endif
  // #ifndef WEB
  uni.openDocument({
    filePath: t.savedPath,
    showMenu: true,
    fail: () => {
      uni.showToast({ title: '无法打开该文件格式', icon: 'none' })
    },
  })
  // #endif
}

function cancelTask(id: string) {
  cancelDlTask(id)
}

function retryTask(id: string) {
  retryDlTask(id)
  uni.showToast({ title: '已重新加入队列', icon: 'none' })
}

function removeTask(id: string) {
  removeDlTask(id)
}

function clearFinished() {
  clearFinishedDlTasks()
  uni.showToast({ title: '已清理结束的任务', icon: 'none' })
}
</script>

