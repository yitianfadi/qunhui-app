    flex: 1;
    background-color: #f7f8fa;
  }
  .summary {
    flex-direction: row;
    align-items: center;
    padding: 14px 16px;
    background-color: #ffffff;
    border-bottom: 1px solid #eef1f5;
  }
  .sum-left {
    flex: 1;
    flex-direction: column;
  }
  .sum-title {
    font-size: 16px;
    font-weight: bold;
    color: #222222;
  }
  .sum-sub {
    font-size: 12px;
    color: #8a8f99;
    margin-top: 3px;
  }
  .sum-clear {
    font-size: 13px;
    color: #1e6bb8;
    padding: 6px 4px;
  }
  .list {
    flex: 1;
  }
  .task {
    background-color: #ffffff;
    border-radius: 10px;
    margin: 8px 12px;
    padding: 12px 14px 13px 14px;
    flex-direction: column;
  }
  .task-head {
    flex-direction: row;
    align-items: center;
  }
  .task-icon {
    font-size: 24px;
    margin-right: 10px;
  }
  .task-main {
    flex: 1;
    flex-direction: column;
  }
  .task-name {
    font-size: 14px;
    color: #222222;
  }
  .task-meta {
    font-size: 12px;
    color: #8a8f99;
    margin-top: 3px;
  }
  .task-act {
    font-size: 13px;
    padding: 6px 8px;
  }
  .task-act-primary {
    color: #1e6bb8;
  }
  .task-act-danger {
    color: #d94838;
  }
  .bar {
    height: 6px;
    border-radius: 3px;
    background-color: #eef1f5;
    margin-top: 10px;
    overflow: hidden;
  }
  .bar-in {
    height: 6px;
    border-radius: 3px;
    background-color: #1e6bb8;
  }
  .task-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
  }
  .task-size {
    flex: 1;
    font-size: 12px;
    color: #8a8f99;
  }
  .task-err {
    flex: 1;
    font-size: 12px;
    color: #d94838;
  }
  .task-del {
    font-size: 12px;
    color: #b0b5bd;
    padding: 4px 0 4px 12px;
  }
  .empty-box {
    padding: 70px 32px;
    align-items: center;
  }
  .empty-icon {
    font-size: 44px;
    margin-bottom: 14px;
  }
  .empty-title {
    font-size: 15px;
    color: #444444;
    margin-bottom: 8px;
  }
  .empty-hint {
    font-size: 12px;
    color: #8a8f99;
    text-align: center;
    width: 100%;
    line-height: 20px;
  }
  .bottom-space {
    height: 40px;
  }
</style>
