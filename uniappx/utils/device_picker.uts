// 手机端「文件 / 文件夹」选择封装
// 依赖内置 UTS 插件 uni_modules/qh-file-picker（仅 Android App 可用）
// Web / iOS 上所有方法都会以「不支持」拒绝，调用方需自行降级

// #ifdef APP-ANDROID
import { pickFiles, pickDirectory, exportToCache, clearCache, nativeUpload, cancelNativeUpload, nativeUploadProgress } from '@/uni_modules/qh-file-picker'
// #endif

/** 手机上的一个文件（content:// 地址） */
export type DeviceFile = {
  name: string
  size: number
  uri: string
  /** 相对所选文件夹的路径；直接选文件时等于文件名 */
  relativePath: string
}

/** 选中的整个文件夹 */
export type DeviceDir = {
  dirName: string
  files: Array<DeviceFile>
  totalSize: number
  /** 是否因超过 maxFiles 被截断 */
  truncated: boolean
}

/** 当前平台是否支持（仅 Android App） */
export function devicePickerSupported(): boolean {
  // #ifdef APP-ANDROID
  return true
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

function toDeviceFile(f: any): DeviceFile {
  const size = typeof f.size === 'number' ? f.size : 0
  const name: string = typeof f.name === 'string' ? f.name : ''
  let rel: string = typeof f.relativePath === 'string' ? f.relativePath : ''
  if (rel.length == 0) {
    rel = name
  }
  const item: DeviceFile = {
    name: name,
    size: size,
    uri: typeof f.uri === 'string' ? f.uri : '',
    relativePath: rel,
  }
  return item
}

/** 选择单个/多个文件（系统文件选择器） */
export function devicePickFiles(count: number, mimeType: string): Promise<Array<DeviceFile>> {
  return new Promise<Array<DeviceFile>>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      count: count,
      mimeType: mimeType.length > 0 ? mimeType : '*/*',
      success: (res: any) => {
        const list: Array<DeviceFile> = []
        const raw = res.files as Array<any>
        for (let i = 0; i < raw.length; i++) {
          list.push(toDeviceFile(raw[i]))
        }
        resolve(list)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    pickFiles(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持选择文件，请在 Android App 中使用'))
    // #endif
  })
}

/** 选择整个文件夹，并递归扫描其中的文件 */
export function devicePickDirectory(maxFiles: number): Promise<DeviceDir> {
  return new Promise<DeviceDir>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      maxFiles: maxFiles,
      success: (res: any) => {
        const list: Array<DeviceFile> = []
        const raw = res.files as Array<any>
        let total = 0
        for (let i = 0; i < raw.length; i++) {
          const f = toDeviceFile(raw[i])
          total = total + f.size
          list.push(f)
        }
        const dir: DeviceDir = {
          dirName: typeof res.dirName === 'string' ? res.dirName : '已选文件夹',
          files: list,
          totalSize: total,
          truncated: res.truncated === true,
        }
        resolve(dir)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    pickDirectory(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持选择文件夹，请在 Android App 中使用'))
    // #endif
  })
}

/** 把 content:// 文件导出到应用缓存目录，返回可上传的本地路径 */
export function deviceExportToCache(uri: string, name: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      uri: uri,
      name: name,
      success: (res: any) => {
        resolve(res.path as string)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    exportToCache(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持该操作'))
    // #endif
  })
}

/** 原生上传返回 */
export type NativeUploadResponse = {
  /** HTTP 状态码 */
  statusCode: number
  /** 响应正文（JSON 字符串） */
  data: string
}

/**
 * 原生流式 multipart 上传（参数段在前、文件段最后）。
 *
 * 为什么需要它：uni.uploadFile 固定把文件段排在 multipart 最前面，
 * 而 DSM 的 SYNO.FileStation.Upload 遇到「文件段在前」直接返回 101；
 * 换成 readFile 自己拼报文又会把整个文件读进内存（大视频必超上限）。
 * 插件里用 HttpURLConnection 边读边发，内存与文件大小无关。
 */
export function deviceNativeUpload(
  url: string,
  sid: string,
  destFolder: string,
  filePath: string,
  fileName: string,
  onProgress: (percent: number) => void
): Promise<NativeUploadResponse> {
  return new Promise<NativeUploadResponse>((resolve, reject) => {
    // #ifdef APP-ANDROID
    // 进度改用「轮询」而不是回调：实测在后台线程里调用 JS 的 onProgress 一次也到不了
    // JS（界面永远停在 0%），所以插件另外暴露了 nativeUploadProgress()，这里定时读。
    let pollTimer = 0
    let lastPercent = -1
    const stopPoll = () => {
      if (pollTimer != 0) {
        clearTimeout(pollTimer)
        pollTimer = 0
      }
    }
    const poll = () => {
      let p = -1
      try {
        p = nativeUploadProgress()
      } catch (e) {
        p = -1
      }
      if (p >= 0 && p != lastPercent && p < 100) {
        lastPercent = p
        onProgress(p)
      }
      pollTimer = setTimeout(poll, 400)
    }
    try {
      nativeUpload({
        url: url,
        sid: sid,
        destFolder: destFolder,
        filePath: filePath,
        fileName: fileName,
        onProgress: (p: number) => {
          // 基座若能把回调送过来就先用着（属于加餐，不是主路径）
          if (p > lastPercent && p < 100) {
            lastPercent = p
            onProgress(p)
          }
        },
        success: (res: any) => {
          stopPoll()
          if (lastPercent < 100) {
            onProgress(100)
          }
          const out: NativeUploadResponse = {
            statusCode: typeof res.statusCode === 'number' ? res.statusCode : 0,
            data: typeof res.data === 'string' ? res.data : '',
          }
          resolve(out)
        },
        fail: (err: any) => {
          stopPoll()
          const msg = err != null && err.errMsg != null ? String(err.errMsg) : '上传失败'
          reject(new Error(msg))
        },
      })
      // 上传线程已启动，开始轮询进度
      poll()
    } catch (e) {
      stopPoll()
      // 当前基座里没有这个方法（还是旧基座）时，调用会直接抛异常。
      // 用固定前缀告诉上层「是插件缺失」，可以安全回退到 uni.uploadFile。
      const msg = e instanceof Error ? e.message : String(e)
      reject(new Error('NATIVE_UNAVAILABLE:' + msg))
    }
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持原生上传'))
    // #endif
  })
}

/** 中断原生上传 */
export function deviceCancelNativeUpload() {
  // #ifdef APP-ANDROID
  try {
    cancelNativeUpload()
  } catch (e) {
    // 忽略
  }
  // #endif
}

/** 清空导出的临时缓存文件 */
export function deviceClearCache(): Promise<number> {
  return new Promise<number>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      success: (res: any) => {
        resolve(typeof res.removed === 'number' ? res.removed : 0)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    clearCache(opts)
    // #endif
    // #ifndef APP-ANDROID
    resolve(0)
    // #endif
  })
}

/**
 * 申请读取相册（图片/视频）的权限。
 *
 * Android 13+ 用 READ_MEDIA_IMAGES / READ_MEDIA_VIDEO，12 及以下用 READ_EXTERNAL_STORAGE。
 *
 * 注意判定口径（这版修的就是这里）：**只有“明确永久拒绝”才算失败**。
 * 之前用 `grantedList.length > 0` 判断，遇到下面三种情况会误报“没有权限”，
 * 而实际上用户早就授权了：
 *   1. 权限已授予时系统不再弹窗，回调里的 grantedList 可能是空数组；
 *   2. Android 14 选「部分照片/视频」时授予的是 READ_MEDIA_VISUAL_USER_SELECTED，
 *      不在请求列表里，grantedList 也是空；
 *   3. 某些 ROM 的回调结构里根本没有 grantedList 字段。
 * 返回 false 仅用于“用户勾了不再询问”的场景，其它情况一律放行，
 * 真正的读取失败交给上传环节报准确错误。
 */
export function ensureMediaReadPermission(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    let settled = false
    let timer = 0
    const done = (ok: boolean) => {
      if (settled) return
      settled = true
      if (timer != 0) {
        clearTimeout(timer)
        timer = 0
      }
      resolve(ok)
    }
    // #ifdef APP-ANDROID
    // 1) 先读「当前」授权状态：已授权就直接放行，不再发起请求
    let state = ''
    try {
      const setting: any = uni.getAppAuthorizeSetting()
      if (setting != null && setting.albumAuthorized != null) {
        state = String(setting.albumAuthorized)
      }
    } catch (e) {
      state = ''
    }
    if (state == 'authorized') {
      done(true)
      return
    }
    // 2) 未决定 / 被拒 → 请求一次；该模块是可选模块，没编进基座时回调不会触发，
    //    所以必须有超时兜底，否则会卡在「点了没反应」
    timer = setTimeout(() => {
      done(true)
    }, 2500)
    try {
      uni.requestSystemPermission({
        permissions: [
          'android.permission.READ_MEDIA_IMAGES',
          'android.permission.READ_MEDIA_VIDEO',
          'android.permission.READ_EXTERNAL_STORAGE',
        ],
        success: (res: any) => {
          const granted: Array<string> = res.grantedList ?? []
          if (granted.length > 0) {
            done(true)
            return
          }
          const deniedAlways: Array<string> = res.deniedAlwaysList ?? []
          // 只有「勾了不再询问」才拦；其余（含拿不到列表）一律放行
          done(deniedAlways.length == 0)
        },
        fail: () => {
          done(true)
        },
      } as any)
    } catch (e) {
      done(true)
    }
    // #endif
    // #ifndef APP-ANDROID
    done(true)
    // #endif
  })
}

/** 当前的相册授权状态：authorized / denied / not determined / unknown */
export function getAlbumAuthorizeState(): string {
  // #ifdef APP-ANDROID
  try {
    const setting: any = uni.getAppAuthorizeSetting()
    if (setting != null && setting.albumAuthorized != null) {
      return String(setting.albumAuthorized)
    }
  } catch (e) {
    return 'unknown'
  }
  // #endif
  return 'unknown'
}

/** 跳转到系统里本应用的权限设置页 */
export function openAppAuthorizeSetting() {
  // #ifdef APP-ANDROID
  try {
    uni.openAppAuthorizeSetting({} as any)
  } catch (e) {
    // 部分 ROM 没有该页面，忽略
  }
  // #endif
}

/**
 * 该路径是否需要先导出到应用缓存才能上传。
 *
 * `uni.request` 读本地文件只认应用沙盒内的路径，下面两类都读不了：
 *  1. content://media/...（相册原始 URI，不是文件系统路径）
 *  2. /storage/emulated/0/... 等外部存储路径（没有存储权限时直接 EACCES）
 * 这两类统一走「插件用 ContentResolver 导出到 cache → 再上传」。
 */
export function needsCacheExport(p: string): boolean {
  if (p.length == 0) return false
  if (p.startsWith('unifile://')) return false
  if (p.startsWith('content://')) return true
  let path = p
  if (path.startsWith('file://')) {
    path = path.substring(7)
  }
  if (path.startsWith('/storage/') || path.startsWith('/sdcard/') || path.startsWith('/mnt/sdcard')) {
    return true
  }
  // 应用私有目录（沙盒）可以直接读
  if (path.startsWith('/data/user/0/') || path.startsWith('/data/data/') || path.startsWith('/data/storage/')) {
    return false
  }
  return false
}

/** 删除上传完成后残留的缓存文件（失败静默） */
export function deviceRemoveFile(path: string) {
  if (path.length == 0) {
    return
  }
  try {
    uni.getFileSystemManager().unlink({
      filePath: toUniFsPath(path),
      fail: () => {
        // 缓存文件删不掉不影响功能，交给系统清理
      },
    })
  } catch (e) {
    // 忽略
  }
}

/**
 * 绝对路径 → uni-app x 的沙盒协议路径。
 *
 * FileSystemManager 把裸 `/data/user/0/<pkg>/...` 当成相对路径拼到 www 下
 * （实测 unlink/copyFile/readFile 都会因此 ENOENT），必须换成 unifile:// 协议。
 */
export function toUniFsPath(p: string): string {
  if (p.startsWith('unifile://')) return p
  if (p.indexOf('://') >= 0) return p
  let cache = ''
  let usr = ''
  try {
    cache = uni.env.CACHE_PATH
    usr = uni.env.USER_DATA_PATH
  } catch (e) {
    return p
  }
  if (cache.length > 0 && (p == cache || p.startsWith(cache + '/'))) {
    return 'unifile://cache' + p.substring(cache.length)
  }
  if (usr.length > 0 && (p == usr || p.startsWith(usr + '/'))) {
    return 'unifile://usr' + p.substring(usr.length)
  }
  const ci = p.indexOf('/cache/')
  if (ci > 0) return 'unifile://cache' + p.substring(ci + 6)
  const fi = p.indexOf('/files/')
  if (fi > 0) return 'unifile://usr' + p.substring(fi + 6)
  return p
}
