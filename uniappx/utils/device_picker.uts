// 手机端「文件 / 文件夹」选择封装
// 依赖内置 UTS 插件 uni_modules/qh-file-picker（仅 Android App 可用）
// Web / iOS 上所有方法都会以「不支持」拒绝，调用方需自行降级

// #ifdef APP-ANDROID
import { pickFiles, pickDirectory, exportToCache, clearCache } from '@/uni_modules/qh-file-picker'
// #endif

/** 手机上的一个文件（content:// 地址） */
export type DeviceFile = {
  name: string
  size: number
  uri: string
  /** 相对所选文件夹的路径；直接选文件时等于文件名 */
  relativePath: string
}

/** 选中的整个文件夹 */
export type DeviceDir = {
  dirName: string
  files: Array<DeviceFile>
  totalSize: number
  /** 是否因超过 maxFiles 被截断 */
  truncated: boolean
}

/** 当前平台是否支持（仅 Android App） */
export function devicePickerSupported(): boolean {
  // #ifdef APP-ANDROID
  return true
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

function toDeviceFile(f: any): DeviceFile {
  const size = typeof f.size === 'number' ? f.size : 0
  const name: string = typeof f.name === 'string' ? f.name : ''
  let rel: string = typeof f.relativePath === 'string' ? f.relativePath : ''
  if (rel.length == 0) {
    rel = name
  }
  const item: DeviceFile = {
    name: name,
    size: size,
    uri: typeof f.uri === 'string' ? f.uri : '',
    relativePath: rel,
  }
  return item
}

/** 选择单个/多个文件（系统文件选择器） */
export function devicePickFiles(count: number, mimeType: string): Promise<Array<DeviceFile>> {
  return new Promise<Array<DeviceFile>>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      count: count,
      mimeType: mimeType.length > 0 ? mimeType : '*/*',
      success: (res: any) => {
        const list: Array<DeviceFile> = []
        const raw = res.files as Array<any>
        for (let i = 0; i < raw.length; i++) {
          list.push(toDeviceFile(raw[i]))
        }
        resolve(list)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    pickFiles(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持选择文件，请在 Android App 中使用'))
    // #endif
  })
}

/** 选择整个文件夹，并递归扫描其中的文件 */
export function devicePickDirectory(maxFiles: number): Promise<DeviceDir> {
  return new Promise<DeviceDir>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      maxFiles: maxFiles,
      success: (res: any) => {
        const list: Array<DeviceFile> = []
        const raw = res.files as Array<any>
        let total = 0
        for (let i = 0; i < raw.length; i++) {
          const f = toDeviceFile(raw[i])
          total = total + f.size
          list.push(f)
        }
        const dir: DeviceDir = {
          dirName: typeof res.dirName === 'string' ? res.dirName : '已选文件夹',
          files: list,
          totalSize: total,
          truncated: res.truncated === true,
        }
        resolve(dir)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    pickDirectory(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持选择文件夹，请在 Android App 中使用'))
    // #endif
  })
}

/** 把 content:// 文件导出到应用缓存目录，返回可上传的本地路径 */
export function deviceExportToCache(uri: string, name: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      uri: uri,
      name: name,
      success: (res: any) => {
        resolve(res.path as string)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    exportToCache(opts)
    // #endif
    // #ifndef APP-ANDROID
    reject(new Error('当前平台不支持该操作'))
    // #endif
  })
}

/** 清空导出的临时缓存文件 */
export function deviceClearCache(): Promise<number> {
  return new Promise<number>((resolve, reject) => {
    // #ifdef APP-ANDROID
    const opts = {
      success: (res: any) => {
        resolve(typeof res.removed === 'number' ? res.removed : 0)
      },
      fail: (err: any) => {
        reject(new Error(err.errMsg))
      },
    }
    clearCache(opts)
    // #endif
    // #ifndef APP-ANDROID
    resolve(0)
    // #endif
  })
}

/**
 * 申请读取相册（图片/视频）的权限。
 *
 * Android 13+ 用 READ_MEDIA_IMAGES / READ_MEDIA_VIDEO，12 及以下用 READ_EXTERNAL_STORAGE。
 * 三个一起申请即可：系统会忽略当前版本不支持的项（grantedList 只返回支持的）。
 *
 * 返回 true 表示至少拿到一项读取权限；用户拒绝时返回 false（调用方应提示去设置里开）。
 */
export function ensureMediaReadPermission(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    let settled = false
    let timer = 0
    const done = (ok: boolean) => {
      if (settled) return
      settled = true
      if (timer != 0) {
        clearTimeout(timer)
        timer = 0
      }
      resolve(ok)
    }
    // #ifdef APP-ANDROID
    try {
      // 该模块是可选模块：基座/安装包没编进去时回调不会触发，
      // 因此必须有超时兜底，否则会卡在「点了没反应」
      timer = setTimeout(() => {
        done(true)
      }, 2500)
      uni.requestSystemPermission({
        permissions: [
          'android.permission.READ_MEDIA_IMAGES',
          'android.permission.READ_MEDIA_VIDEO',
          'android.permission.READ_EXTERNAL_STORAGE',
        ],
        success: (res: any) => {
          const granted: Array<string> = res.grantedList ?? []
          done(granted.length > 0)
        },
        fail: () => {
          done(true)
        },
      } as any)
    } catch (e) {
      done(true)
    }
    // #endif
    // #ifndef APP-ANDROID
    done(true)
    // #endif
  })
}

/**
 * 该路径是否需要先导出到应用缓存才能上传。
 *
 * `uni.request` 读本地文件只认应用沙盒内的路径，下面两类都读不了：
 *  1. content://media/...（相册原始 URI，不是文件系统路径）
 *  2. /storage/emulated/0/... 等外部存储路径（没有存储权限时直接 EACCES）
 * 这两类统一走「插件用 ContentResolver 导出到 cache → 再上传」。
 */
export function needsCacheExport(p: string): boolean {
  if (p.length == 0) return false
  if (p.startsWith('unifile://')) return false
  if (p.startsWith('content://')) return true
  let path = p
  if (path.startsWith('file://')) {
    path = path.substring(7)
  }
  if (path.startsWith('/storage/') || path.startsWith('/sdcard/') || path.startsWith('/mnt/sdcard')) {
    return true
  }
  // 应用私有目录（沙盒）可以直接读
  if (path.startsWith('/data/user/0/') || path.startsWith('/data/data/') || path.startsWith('/data/storage/')) {
    return false
  }
  return false
}

/** 删除上传完成后残留的缓存文件（失败静默） */
export function deviceRemoveFile(path: string) {
  if (path.length == 0) {
    return
  }
  try {
    uni.getFileSystemManager().unlink({
      filePath: toUniFsPath(path),
      fail: () => {
        // 缓存文件删不掉不影响功能，交给系统清理
      },
    })
  } catch (e) {
    // 忽略
  }
}

/**
 * 绝对路径 → uni-app x 的沙盒协议路径。
 *
 * FileSystemManager 把裸 `/data/user/0/<pkg>/...` 当成相对路径拼到 www 下
 * （实测 unlink/copyFile/readFile 都会因此 ENOENT），必须换成 unifile:// 协议。
 */
export function toUniFsPath(p: string): string {
  if (p.startsWith('unifile://')) return p
  if (p.indexOf('://') >= 0) return p
  let cache = ''
  let usr = ''
  try {
    cache = uni.env.CACHE_PATH
    usr = uni.env.USER_DATA_PATH
  } catch (e) {
    return p
  }
  if (cache.length > 0 && (p == cache || p.startsWith(cache + '/'))) {
    return 'unifile://cache' + p.substring(cache.length)
  }
  if (usr.length > 0 && (p == usr || p.startsWith(usr + '/'))) {
    return 'unifile://usr' + p.substring(usr.length)
  }
  const ci = p.indexOf('/cache/')
  if (ci > 0) return 'unifile://cache' + p.substring(ci + 6)
  const fi = p.indexOf('/files/')
  if (fi > 0) return 'unifile://usr' + p.substring(fi + 6)
  return p
}
