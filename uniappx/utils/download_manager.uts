// 全局下载队列：文件页 / 照片页提交任务，下载页统一展示进度
// 队列串行执行（一次只跑一个任务），避免多任务抢带宽
import { ref } from 'vue'
import { formatSize } from './syno.uts'

/** 任务状态：waiting 等待 / downloading 下载中 / done 已完成 / failed 失败 / canceled 已取消 */
export type DlTask = {
  id: string
  name: string
  nasPath: string
  url: string
  status: string
  percent: number
  sizeText: string
  /** 实时速度文案，如 12.3 MB/s */
  speedText: string
  savedPath: string
  error: string
  timeText: string
  /** 批量分组 id（'' = 单任务），文件夹批量下载的任务共用一个组 */
  groupId: string
  /** 批量分组名（源文件夹名），用于传输中心的组进度行 */
  groupName: string
}

/** 全局任务列表（跨页面共享，模板中直接遍历） */
export const dlTaskList = ref<Array<DlTask>>([])

/** 同时下载的任务数上限（3 路并发：完成一个自动补位） */
const MAX_DL_PARALLEL = 3

/** 进行中任务 id（最多 MAX_DL_PARALLEL 个） */
const activeIds: Array<string> = []
/** 进行中任务的原生下载对象（abort 用，按任务 id 索引） */
const activeTasks = new Map<string, any>()
let seq = 0

function pad2(n: number): string {
  return n < 10 ? '0' + n : '' + n
}

function timeNow(): string {
  const d = new Date()
  return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

/** 文件名安全化：去掉路径分隔符，避免写入子目录失败 */
function safeFileName(n: string): string {
  let s = n.split('/').join('_')
  s = s.split('\\').join('_')
  return s.length > 0 ? s : 'unnamed'
}

function findTask(id: string): DlTask | null {
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].id === id) return list[i]
  }
  return null
}

/** 进行中任务数（等待 + 下载中） */
export function dlActiveCount(): number {
  let n = 0
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    const s = list[i].status
    if (s === 'waiting' || s === 'downloading') {
      n = n + 1
    }
  }
  return n
}

/** 已完成任务数 */
export function dlDoneCount(): number {
  let n = 0
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'done') n = n + 1
  }
  return n
}

/** 应用持久目录（uni.env 在 Web 端不存在，用 try 兜底） */
function ensureDir(dir: string): Promise<void> {
  return new Promise<void>((resolve) => {
    let settled = false
    const done = () => {
      if (!settled) {
        settled = true
        resolve()
      }
    }
    try {
      uni.getFileSystemManager().mkdir({
        dirPath: dir,
        recursive: true,
        // 目录已存在时会走 fail，这里统一 resolve 继续
        success: done,
        fail: done,
        complete: done,
      } as any)
    } catch (e) {
      done()
    }
  })
}

/** 判断路径是否存在（目录/文件均可） */
function pathExists(p: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    let settled = false
    const done = (v: boolean) => {
      if (!settled) {
        settled = true
        resolve(v)
      }
    }
    try {
      uni.getFileSystemManager().access({
        path: p,
        success: () => done(true),
        fail: () => done(false),
      } as any)
    } catch (e) {
      done(false)
    }
  })
}

/** 复制文件，失败返回 false（不抛异常，避免 Promise 悬住） */
function copyFileSafe(src: string, dest: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    let settled = false
    const done = (v: boolean) => {
      if (!settled) {
        settled = true
        resolve(v)
      }
    }
    try {
      uni.getFileSystemManager().copyFile({
        srcPath: src,
        destPath: dest,
        success: () => done(true),
        fail: () => done(false),
      } as any)
    } catch (e) {
      done(false)
    }
  })
}

/** 任意值转数字（UTS 无 Number() 构造，按项目约定用 typeof + parseFloat） */
function toNum(v: any, def: number): number {
  if (v == null) return def
  if (typeof v === 'number') return v as number
  if (typeof v === 'string') {
    const s = v as string
    if (s.length === 0) return def
    const n = parseFloat(s)
    // NaN 时三个比较都不成立，回落默认值
    if (n > 0 || n < 0 || n === 0) return n
    return def
  }
  return def
}

/** 读取文件大小（字节）；文件不存在或读取失败返回 -1 */
function fileSize(p: string): Promise<number> {
  return new Promise<number>((resolve) => {
    let settled = false
    const done = (v: number) => {
      if (!settled) {
        settled = true
        resolve(v)
      }
    }
    try {
      uni.getFileSystemManager().stat({
        path: p,
        recursive: false,
        success: (res: any) => {
          try {
            const arr = res.stats as Array<any>
            if (arr != null && arr.length > 0) {
              const inner = arr[0]['stats']
              if (inner != null) {
                done(toNum(inner['size'], -1))
                return
              }
            }
          } catch (e) {
            // 结构异常时统一按失败处理
          }
          done(-1)
        },
        fail: () => done(-1),
        complete: () => {},
      } as any)
    } catch (e) {
      done(-1)
    }
  })
}

/** 删除已存在的文件（不存在也算成功，不抛异常） */
function removeFileIfExists(p: string): Promise<void> {
  return new Promise<void>((resolve) => {
    let settled = false
    const done = () => {
      if (!settled) {
        settled = true
        resolve()
      }
    }
    try {
      uni.getFileSystemManager().unlink({
        filePath: p,
        success: done,
        fail: done,
        complete: done,
      } as any)
    } catch (e) {
      done()
    }
  })
}

/**
 * 确保下载目录可用，返回真正可写的目录。
 * Android 上 mkdir 偶发不生效（实测 files/download 未创建导致 copyFile ENOENT），
 * 因此建完必须回查，失败就回退到 USER_DATA_PATH 根目录。
 */
async function ensureDownloadDir(): Promise<string> {
  let base = ''
  try {
    base = uni.env.USER_DATA_PATH
  } catch (e) {
    base = ''
  }
  if (base.length === 0) {
    return '/'
  }
  const dir = base + '/download'
  if (await pathExists(dir)) {
    return dir
  }
  await ensureDir(dir)
  if (await pathExists(dir)) {
    return dir
  }
  // 回退：直接放应用 files 根目录（一定存在）
  return base
}

/**
 * 提交下载任务（App 端调用；Web 端由调用方走浏览器下载）
 * @param url 完整下载地址（含 sid）
 * @param name 文件名
 * @param nasPath NAS 上的原始路径（仅用于记录）
 * @param openInBrowser Web 端是否立即交给浏览器（批量备份时传 false，避免弹出大量标签页）
 */
export function startDownload(
  url: string,
  name: string,
  nasPath: string,
  openInBrowser: boolean = true
): DlTask {
  const list = dlTaskList.value
  // 同一文件正在下载中则不重复提交
  for (let i = 0; i < list.length; i++) {
    if (list[i].name === name && list[i].status === 'downloading') {
      return list[i]
    }
  }
  // #ifdef WEB
  // Web 端无文件系统写入能力：在点击的同步链里直接交给浏览器，仅记录一条历史
  if (openInBrowser) {
    window.open(url, '_blank')
  }
  // #endif

  seq = seq + 1
  const t: DlTask = {
    id: 'dl' + Date.now() + '_' + seq,
    name: safeFileName(name),
    nasPath: nasPath,
    url: url,
    status: 'waiting',
    percent: 0,
    sizeText: '等待中…',
    speedText: '',
    savedPath: '',
    error: '',
    timeText: timeNow(),
    groupId: '',
    groupName: '',
  }

  // #ifdef WEB
  t.status = 'done'
  t.percent = 100
  t.sizeText = openInBrowser ? '已交给浏览器下载' : '批量备份请使用 App 端'
  // #endif

  // 新任务插到最前（列表最近的在上方）
  const next: Array<DlTask> = [t]
  dlTaskList.value = next.concat(list)
  // #ifndef WEB
  pump()
  // #endif
  return t
}

/** 批量提交条目 */
export type DlBatchItem = {
  url: string
  name: string
  nasPath: string
}

/**
 * 批量提交下载任务（文件夹批量下载专用）：
 * - 一次性构建数组后整组插入 reactive 列表（单次数组复制，避免逐个头插时
 *   每个文件都触发一次列表复制 + 全量重渲染导致 UI 卡死）
 * - 任务追加到列表末尾（批量任务排到手动任务后面，列表"最近的在上方"不被冲乱）
 * - 同名且未结束的任务跳过（查重一次遍历完成）
 * @returns 实际加入的任务数
 */
export function startDownloadBatch(items: Array<DlBatchItem>, groupId: string, groupName: string): number {
  const list = dlTaskList.value
  // 查重表：未结束任务的 name
  const busy = new Map<string, boolean>()
  for (let i = 0; i < list.length; i++) {
    const s = list[i].status
    if (s === 'waiting' || s === 'downloading') {
      busy.set(list[i].name, true)
    }
  }
  const added: Array<DlTask> = []
  const now = timeNow()
  for (let k = 0; k < items.length; k++) {
    const nm = safeFileName(items[k].name)
    if (busy.get(nm) == true) continue
    busy.set(nm, true)
    seq = seq + 1
    const t: DlTask = {
      id: 'dl' + Date.now() + '_' + seq,
      name: nm,
      nasPath: items[k].nasPath,
      url: items[k].url,
      status: 'waiting',
      percent: 0,
      sizeText: '等待中…',
      speedText: '',
      savedPath: '',
      error: '',
      timeText: now,
      groupId: groupId,
      groupName: groupName,
    }
    added.push(t)
  }
  if (added.length > 0) {
    dlTaskList.value = list.concat(added)
    // #ifndef WEB
    pump()
    // #endif
  }
  return added.length
}

/** 补位启动等待任务，直到占满并发上限 */
function pump() {
  while (activeIds.length < MAX_DL_PARALLEL) {
    const list = dlTaskList.value
    let nextId = ''
    // 从最靠后（最早提交）的等待任务开始
    for (let i = list.length - 1; i >= 0; i--) {
      if (list[i].status === 'waiting') {
        nextId = list[i].id
        break
      }
    }
    if (nextId.length === 0) return
    const t = findTask(nextId)
    if (t == null) return
    runTask(t)
  }
}

async function runTask(t: DlTask) {
  activeIds.push(t.id)
  t.status = 'downloading'
  t.percent = 0
  t.sizeText = '准备中…'
  t.speedText = ''
  const dir = await ensureDownloadDir()
  const dest = dir + '/' + t.name
  // 同名旧文件先删掉：否则平台会自动改名成 name(1).ext，
  // 后续按 dest 校验会拿到旧文件（或误判文件不存在）
  await removeFileIfExists(dest)

  let finished = false
  let watchdog = 0
  let guard = 0
  let guardArmed = false

  // 无效 id 下 clearTimeout 是空操作，直接无条件清
  const clearTimers = () => {
    clearTimeout(watchdog)
    clearTimeout(guard)
    watchdog = 0
    guard = 0
  }

  try {
    await new Promise<void>((resolveP) => {
      let task: any = null
      // 速度采样（每 400ms 用增量字节数计算瞬时速度）
      let lastBytes = 0
      let lastMs = Date.now()
      let lastSpeed = ''
      // 最后一次有进度的时间，看门狗据此判断是否真的卡死
      let lastActive = Date.now()

      /** 收尾：写状态 + 结束 Promise（多次调用只生效一次） */
      const finish = (ok: boolean, path: string, msg: string) => {
        if (finished) return
        finished = true
        clearTimers()
        if (ok) {
          t.savedPath = path
          t.status = 'done'
          t.percent = 100
        } else if (t.status !== 'canceled') {
          t.status = 'failed'
          t.error = msg
          t.sizeText = '下载失败'
        }
        resolveP()
      }

      /**
       * 进度到 100% 后主动确认文件真的落盘。
       * 100% 只代表字节收完；success 回调在部分 Android 机型上会明显延后甚至不回调，
       * 只依赖 success 会让任务永远停在"下载中 100%"。
       */
      const confirmSaved = (round: number, prevSize: number) => {
        fileSize(dest).then((sz: number) => {
          if (finished) return
          // 连续两次采样大小一致才算写完（避免文件仍在增长时误判完成）
          if (sz > 0 && sz === prevSize) {
            finish(true, dest, '')
            return
          }
          if (round >= 12) {
            if (sz > 0) {
              finish(true, dest, '')
            } else {
              finish(false, '', '已下载到 100% 但文件未落盘，请检查存储空间或权限')
            }
            return
          }
          guard = setTimeout(() => {
            confirmSaved(round + 1, sz)
          }, 500) as any
        })
      }

      // 看门狗：超过 120 秒没有任何进度推进 → 判失败，避免长期挂在"下载中"
      const armWatchdog = () => {
        watchdog = setTimeout(() => {
          if (finished) return
          if (Date.now() - lastActive > 120000) {
            if (task != null) {
              try {
                task.abort()
              } catch (e) {
                // 原生任务可能已被释放
              }
            }
            finish(false, '', '下载无响应（120 秒无进度），请检查网络后重试')
            return
          }
          armWatchdog()
        }, 5000) as any
      }
      armWatchdog()

      task = uni.downloadFile({
        url: t.url,
        // 注意：不要传 filePath 指向 uni.env.USER_DATA_PATH 下的路径。
        // 实测（DSM 7.4 + uni-app x 5.34 / Android）：传内部存储路径时原生层
        // open 目标文件报 FileNotFoundException ENOENT，且 success/fail 都不回调，
        // 任务就永远停在 100%（日志：files/download/xxx.jpg: open failed: ENOENT）。
        // 改为让平台写自己默认可写的缓存目录，成功后再复制到下载目录。
        timeout: 600000,
        success: (res: any) => {
          if (finished) return
          const code = toNum(res.statusCode, 0)
          // 非 2xx 说明拿到的是错误页（sid 失效时 DSM 会返回 HTML/JSON 错误）
          if (code > 0 && (code < 200 || code >= 300)) {
            finish(false, '', '服务器返回 HTTP ' + code + '（登录可能已失效）')
            return
          }
          const tmp = String(res.tempFilePath ?? '')
          if (tmp.length === 0) {
            finish(false, '', '下载已结束但没有拿到临时文件')
            return
          }
          // 平台若已落到目标目录（例如同名后缀处理），直接用
          if (tmp.indexOf(dir) === 0) {
            finish(true, tmp, '')
            return
          }
          // 复制到下载目录；失败仍保留临时文件路径，至少能打开
          copyFileSafe(tmp, dest).then((ok: boolean) => {
            if (finished) return
            finish(true, ok ? dest : tmp, '')
          })
        },
        fail: (err: any) => {
          if (finished) return
          // err 可能为 null，直接取 err.errMsg 会抛异常并把 Promise 悬死
          let msg = '下载失败'
          try {
            if (err != null) {
              const m = String(err.errMsg ?? '')
              if (m.length > 0) msg = m
            }
          } catch (e) {
            // 保持默认文案
          }
          finish(false, '', msg)
        },
        complete: () => {
          activeTasks.delete(t.id)
        },
      })
      activeTasks.set(t.id, task)

      task?.onProgressUpdate((p: any) => {
        if (finished) return
        lastActive = Date.now()
        const written = toNum(p.totalBytesWritten, 0)
        const expected = toNum(p.totalBytesExpectedToWrite, 0)
        const now = Date.now()
        const dt = now - lastMs
        if (dt >= 400) {
          const db = written - lastBytes
          lastSpeed = formatSize(db * 1000 / dt) + '/s'
          lastBytes = written
          lastMs = now
        }
        const pct = toNum(p.progress, 0)
        t.percent = pct
        t.speedText = lastSpeed
        const head = lastSpeed.length > 0 ? lastSpeed + ' · ' : ''
        t.sizeText = head + formatSize(written) + ' / ' + formatSize(expected)
        // 字节收完 → 主动确认落盘，不等 success 回调
        if (pct >= 100 && !guardArmed) {
          guardArmed = true
          guard = setTimeout(() => {
            confirmSaved(0, -1)
          }, 600) as any
        }
      })
    })
  } catch (e) {
    if (t.status !== 'canceled') {
      t.status = 'failed'
      t.error = e instanceof Error ? e.message : String(e)
      t.sizeText = '下载失败'
    }
  } finally {
    finished = true
    clearTimers()
    // 从并发占用表移除自己，并补位启动下一个等待任务
    for (let i = 0; i < activeIds.length; i++) {
      if (activeIds[i] === t.id) {
        activeIds.splice(i, 1)
        break
      }
    }
    activeTasks.delete(t.id)
    pump()
  }
}

/** 取消任务（等待中直接标记，下载中中断网络请求） */
export function cancelDlTask(id: string) {
  const t = findTask(id)
  if (t == null) return
  if (t.status === 'downloading') {
    t.status = 'canceled'
    t.sizeText = '已取消'
    const tk = activeTasks.get(id)
    if (tk != null) {
      try {
        tk.abort()
      } catch (e) {
        // 原生任务可能已被释放
      }
      activeTasks.delete(id)
    }
  } else if (t.status === 'waiting') {
    t.status = 'canceled'
    t.sizeText = '已取消'
  }
}

/** 取消整组批量任务（文件夹批量下载） */
export function cancelDlGroup(groupId: string) {
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    const t = list[i]
    if (t.groupId !== groupId) continue
    if (t.status === 'waiting') {
      t.status = 'canceled'
      t.sizeText = '已取消'
    } else if (t.status === 'downloading') {
      t.status = 'canceled'
      t.sizeText = '已取消'
      const tk = activeTasks.get(t.id)
      if (tk != null) {
        try {
          tk.abort()
        } catch (e) {
          // 原生任务可能已被释放
        }
        activeTasks.delete(t.id)
      }
    }
  }
}

/** 组下载进度：total / done / failed（仅统计该组任务） */
export type DlGroupProgress = {
  total: number
  done: number
  failed: number
  active: boolean
}

export function dlGroupProgress(groupId: string): DlGroupProgress {
  const r: DlGroupProgress = { total: 0, done: 0, failed: 0, active: false }
  const list = dlTaskList.value
  for (let i = 0; i < list.length; i++) {
    const t = list[i]
    if (t.groupId !== groupId) continue
    r.total = r.total + 1
    if (t.status === 'done') r.done = r.done + 1
    else if (t.status === 'failed') r.failed = r.failed + 1
    if (t.status === 'waiting' || t.status === 'downloading') r.active = true
  }
  return r
}

/** 从列表移除单条记录（不会删除磁盘文件） */
export function removeDlTask(id: string) {
  const list = dlTaskList.value
  const next: Array<DlTask> = []
  for (let i = 0; i < list.length; i++) {
    if (list[i].id !== id) next.push(list[i])
  }
  dlTaskList.value = next
}

/** 清空所有已结束（完成/失败/取消）的记录 */
export function clearFinishedDlTasks() {
  const list = dlTaskList.value
  const next: Array<DlTask> = []
  for (let i = 0; i < list.length; i++) {
    const s = list[i].status
    if (s === 'waiting' || s === 'downloading') next.push(list[i])
  }
  dlTaskList.value = next
}

/** 重试失败/取消的任务 */
export function retryDlTask(id: string) {
  const t = findTask(id)
  if (t == null) return
  if (t.status === 'failed' || t.status === 'canceled') {
    t.status = 'waiting'
    t.percent = 0
    t.error = ''
    t.sizeText = '等待中…'
    t.savedPath = ''
    pump()
  }
}
