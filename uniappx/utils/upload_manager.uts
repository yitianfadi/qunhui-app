// 全局上传队列：手机 → NAS 备份（照片 / 文件）
// 与下载队列一样串行执行，一次只传一个文件，避免多任务抢带宽
import { ref } from 'vue'
import { api, formatSize, SynoError } from './syno.uts'
import { deviceExportToCache, deviceRemoveFile, needsCacheExport } from './device_picker.uts'

/** 状态：waiting 等待 / uploading 上传中 / done 已完成 / failed 失败 / canceled 已取消 */
export type UpTask = {
  id: string
  name: string
  localPath: string
  destFolder: string
  status: string
  percent: number
  sizeText: string
  error: string
  timeText: string
  /** 来自系统文件选择器的 content:// 地址（非空时上传前先导出到缓存） */
  contentUri: string
}

/** 批量入队的请求项（一次选几千个文件时，避免逐条插入造成的 O(n²) 开销） */
export type UploadRequest = {
  localPath: string
  contentUri: string
  name: string
  destFolder: string
}

/** 全局上传任务列表（跨页面共享） */
export const upTaskList = ref<Array<UpTask>>([])

let currentId = ''
let currentTask: any = null
let seq = 0

// ---------------- 上传选项（同名策略 / 日期子目录） ----------------

/** 同名文件处理策略：overwrite 覆盖 / skip 跳过 / rename 自动重命名 */
let conflictPolicy = 'overwrite'
/** 是否在目标目录下按日期建子目录（/photo → /photo/2026-11-14） */
let dateSubdir = false

try {
  const p = uni.getStorageSync('upload_conflict_policy')
  if (typeof p === 'string' && (p as string).length > 0) {
    conflictPolicy = p as string
  }
  const ds = uni.getStorageSync('upload_date_subdir')
  if (typeof ds === 'string') {
    dateSubdir = (ds as string) === '1'
  }
} catch (e) {
  // 存储不可用时用默认值
}

export function getConflictPolicy(): string {
  return conflictPolicy
}

export function setConflictPolicy(v: string) {
  conflictPolicy = v
  try {
    uni.setStorageSync('upload_conflict_policy', v)
  } catch (e) {
    // 忽略
  }
}

export function getDateSubdir(): boolean {
  return dateSubdir
}

export function setDateSubdir(v: boolean) {
  dateSubdir = v
  try {
    uni.setStorageSync('upload_date_subdir', v ? '1' : '0')
  } catch (e) {
    // 忽略
  }
}

/** 今天的日期目录名，如 2026-11-14 */
function todayDirName(): string {
  const d = new Date()
  return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate())
}

/** 按开关把目标目录转换成实际写入目录 */
function applyDestFolder(base: string): string {
  if (!dateSubdir) {
    return base
  }
  let b = base
  while (b.length > 1 && b.endsWith('/')) {
    b = b.substring(0, b.length - 1)
  }
  return b + '/' + todayDirName()
}

// ---------------- 仅 Wi-Fi 上传 ----------------

/** 只允许在 Wi-Fi 下上传 */
let wifiOnly = false
/** 用户在提示条上点了「仍要继续」，本次会话内放行 */
let forceCellular = false
/** 当前网络类型（uni.getNetworkType 的返回值，未探测到时为空串） */
let currentNetwork = ''
let networkWatchReady = false

/** 队列是否因为「非 Wi-Fi」被暂停（UI 用来显示提示条） */
export const upNetworkBlocked = ref(false)

try {
  const w = uni.getStorageSync('upload_wifi_only')
  if (typeof w === 'string') {
    wifiOnly = (w as string) === '1'
  }
} catch (e) {
  // 忽略
}

export function getWifiOnly(): boolean {
  return wifiOnly
}

export function setWifiOnly(v: boolean) {
  wifiOnly = v
  forceCellular = false
  try {
    uni.setStorageSync('upload_wifi_only', v ? '1' : '0')
  } catch (e) {
    // 忽略
  }
  if (!v) {
    upNetworkBlocked.value = false
    pump()
  }
}

function ensureNetworkWatch() {
  if (networkWatchReady) {
    return
  }
  networkWatchReady = true
  try {
    uni.getNetworkType({
      success: (res: any) => {
        currentNetwork = typeof res.networkType === 'string' ? res.networkType : ''
      },
      fail: () => {
        currentNetwork = ''
      },
    } as any)
  } catch (e) {
    currentNetwork = ''
  }
  try {
    uni.onNetworkStatusChange((res: any) => {
      currentNetwork = typeof res.networkType === 'string' ? res.networkType : ''
      if (currentNetwork === 'wifi') {
        // 切回 Wi-Fi 自动继续
        forceCellular = false
        pump()
      } else {
        upNetworkBlocked.value = shouldBlockByNetwork()
      }
    } as any)
  } catch (e) {
    // 忽略
  }
}

/** 非 Wi-Fi 且开关打开时拦截；网络类型未知时放行（避免误拦） */
function shouldBlockByNetwork(): boolean {
  if (!wifiOnly || forceCellular) {
    return false
  }
  if (currentNetwork.length === 0 || currentNetwork === 'unknown' || currentNetwork === 'wifi') {
    return false
  }
  return true
}

/** 用户在「非 Wi-Fi」提示条上点「仍要继续」 */
export function allowCellularUpload() {
  forceCellular = true
  upNetworkBlocked.value = false
  pump()
}

// ---------------- 同名冲突检测 ----------------

/** 目录 → 文件名列表（10 秒内复用，避免批量上传时每个文件都列一次目录） */
const dirNameCache = new Map<string, Array<string>>()
const dirCacheAt = new Map<string, number>()

function rememberName(folder: string, name: string) {
  const names = dirNameCache.get(folder)
  if (names != null && names.indexOf(name) < 0) {
    names.push(name)
  }
}

async function knownNames(folder: string): Promise<Array<string>> {
  const now = Date.now()
  const at = dirCacheAt.get(folder)
  if (at != null && now - at < 10000) {
    const cached = dirNameCache.get(folder)
    if (cached != null) {
      return cached
    }
  }
  try {
    const files = await api.listFiles(folder)
    const names: Array<string> = []
    for (let i = 0; i < files.length; i++) {
      names.push(files[i].name)
    }
    dirNameCache.set(folder, names)
    dirCacheAt.set(folder, now)
    return names
  } catch (e) {
    // 目录不存在 / 没权限：交给上传本身的错误提示，这里当作空目录
    return []
  }
}

/** 拆成「主名 + 扩展名」 */
function splitExt(name: string): Array<string> {
  const i = name.lastIndexOf('.')
  if (i <= 0) {
    return [name, '']
  }
  return [name.substring(0, i), name.substring(i)]
}

/** 生成不与现有文件冲突的名字：xxx (1).mp4、xxx (2).mp4… */
function nextFreeName(name: string, taken: Array<string>): string {
  const parts = splitExt(name)
  let i = 1
  while (i <= 9999) {
    const cand = parts[0] + ' (' + i + ')' + parts[1]
    if (taken.indexOf(cand) < 0) {
      return cand
    }
    i = i + 1
  }
  return parts[0] + '_' + Date.now().toString() + parts[1]
}

/**
 * 待上传队列（FIFO，只存 id）
 * 之前每次 pump 都从任务数组末尾倒扫，任务多时退化为 O(n²)；
 * 改为显式队列后，每个任务只会被取一次。
 */
let pendingIds: Array<string> = []

/** 单次可容纳的最大排队数（防止误选整个存储导致内存爆炸） */
const MAX_PENDING = 100000

function pad2(n: number): string {
  return n < 10 ? '0' + n : '' + n
}

function timeNow(): string {
  const d = new Date()
  return pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

function findTask(id: string): UpTask | null {
  const list = upTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].id === id) return list[i]
  }
  return null
}

/** 进行中任务数 */
export function upActiveCount(): number {
  let n = 0
  const list = upTaskList.value
  for (let i = 0; i < list.length; i++) {
    const s = list[i].status
    if (s === 'waiting' || s === 'uploading') n = n + 1
  }
  return n
}

/** 已完成任务数 */
export function upDoneCount(): number {
  let n = 0
  const list = upTaskList.value
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'done') n = n + 1
  }
  return n
}

/**
 * 提交上传任务
 * @param localPath 手机本地路径
 * @param fileName 保存到 NAS 的文件名
 * @param destFolder NAS 目标目录
 */
export function startUpload(localPath: string, fileName: string, destFolder: string): UpTask {
  return createTask(localPath, '', fileName, destFolder)
}

/**
 * 从系统文件选择器返回的 content:// 地址提交上传任务
 * 上传时才导出到缓存，避免一次选中几百个文件把缓存塞满
 */
export function startUploadFromUri(uri: string, fileName: string, destFolder: string): UpTask {
  return createTask('', uri, fileName, destFolder)
}

function createTask(localPath: string, contentUri: string, fileName: string, destFolder: string): UpTask {
  ensureNetworkWatch()
  seq = seq + 1
  const t: UpTask = {
    id: 'up' + Date.now() + '_' + seq,
    name: fileName,
    localPath: localPath,
    destFolder: applyDestFolder(destFolder),
    status: 'waiting',
    percent: 0,
    sizeText: '等待中…',
    error: '',
    timeText: timeNow(),
    contentUri: contentUri,
  }
  const next: Array<UpTask> = [t]
  upTaskList.value = next.concat(upTaskList.value)
  if (pendingIds.length < MAX_PENDING) {
    pendingIds.push(t.id)
  }
  pump()
  return t
}

/**
 * 批量入队（选中整个文件夹几千个文件时用）
 * 只做一次数组拼接 + 一次 pump，避免逐条 createTask 的重复开销
 * @returns 实际入队数量
 */
export function startUploadsBatch(reqs: Array<UploadRequest>): number {
  if (reqs.length === 0) {
    return 0
  }
  ensureNetworkWatch()
  const created: Array<UpTask> = []
  const batchTime = timeNow()
  for (let i = 0; i < reqs.length; i++) {
    const r = reqs[i]
    if (created.length >= MAX_PENDING) {
      break
    }
    seq = seq + 1
    const t: UpTask = {
      id: 'up' + Date.now() + '_' + seq,
      name: r.name,
      localPath: r.localPath,
      destFolder: applyDestFolder(r.destFolder),
      status: 'waiting',
      percent: 0,
      sizeText: '等待中…',
      error: '',
      timeText: batchTime,
      contentUri: r.contentUri,
    }
    created.push(t)
    pendingIds.push(t.id)
  }
  if (created.length > 0) {
    // created 内保持原选中顺序，整体放到列表最前（最新的在最上）
    upTaskList.value = created.concat(upTaskList.value)
    pump()
  }
  return created.length
}

function pump() {
  if (currentId.length > 0) return
  if (shouldBlockByNetwork()) {
    upNetworkBlocked.value = true
    return
  }
  upNetworkBlocked.value = false
  while (pendingIds.length > 0) {
    const id = pendingIds.shift()
    if (id == null || id.length === 0) {
      continue
    }
    const t = findTask(id)
    if (t != null && t.status === 'waiting') {
      runTask(t)
      return
    }
  }
}

async function runTask(t: UpTask) {
  currentId = t.id
  t.status = 'uploading'
  t.percent = 0
  t.sizeText = '上传中…'
  let uploadPath = t.localPath
  let fromCache = false
  try {
    // 同名策略：覆盖交给服务端 overwrite=true；跳过/重命名要先知道目标目录里有什么
    if (conflictPolicy !== 'overwrite') {
      const names = await knownNames(t.destFolder)
      if (names.indexOf(t.name) >= 0) {
        if (conflictPolicy === 'skip') {
          t.status = 'done'
          t.percent = 100
          t.sizeText = '已跳过（同名文件已存在）'
          return
        }
        t.name = nextFreeName(t.name, names)
        t.sizeText = '改名为 ' + t.name
      }
    }

    // content:// 或外部存储路径：先导出到应用缓存再上传，上传结束即删除
    // 注意这是「按需」导出：同一时刻磁盘上只有一个文件的副本，不会因为选了几千个就占满空间
    const uri = t.contentUri.length > 0 ? t.contentUri : (needsCacheExport(t.localPath) ? t.localPath : '')
    if (uri.length > 0) {
      t.sizeText = '准备文件…'
      try {
        uploadPath = await deviceExportToCache(uri, t.name)
        fromCache = true
      } catch (e) {
        const raw = e instanceof Error ? e.message : String(e)
        if (raw.indexOf('Permission') >= 0 || raw.indexOf('EACCES') >= 0) {
          throw new Error('读不到相册文件：请在系统设置里允许本应用访问照片和视频后重试')
        }
        throw new Error('读不到本地文件（' + raw + '），可尝试重新选择该文件')
      }
      t.sizeText = '上传中…'
    }
    await api.uploadFile(
      uploadPath,
      t.destFolder,
      t.name,
      (percent: number) => {
        if (t.status !== 'uploading') return
        t.percent = percent
        t.sizeText = '已上传 ' + percent + '%'
      },
      (task: any) => {
        currentTask = task
      }
    )
    t.status = 'done'
    t.percent = 100
    t.sizeText = '已保存到 ' + t.destFolder
    rememberName(t.destFolder, t.name)
  } catch (e) {
    if (t.status !== 'canceled') {
      t.status = 'failed'
      let msg = e instanceof Error ? e.message : String(e)
      // 目录不存在/无权限：提示里带上具体目录，否则队列里全是同一条文案，看不出是配置错
      const code = e instanceof SynoError ? (e as SynoError).code : 0
      if (code === 408 || code === 401 || code === 105) {
        msg = msg + '（目标目录 ' + t.destFolder + '）'
      }
      t.error = msg
      t.sizeText = '上传失败'
    }
  } finally {
    if (fromCache) {
      deviceRemoveFile(uploadPath)
    }
    currentId = ''
    currentTask = null
    pump()
  }
}

/** 取消上传（等待中直接标记；上传中中断请求） */
export function cancelUpTask(id: string) {
  const t = findTask(id)
  if (t == null) return
  if (t.status === 'uploading') {
    t.status = 'canceled'
    t.sizeText = '已取消'
    if (currentTask != null) {
      currentTask.abort()
      currentTask = null
    }
  } else if (t.status === 'waiting') {
    t.status = 'canceled'
    t.sizeText = '已取消'
  }
}

export function removeUpTask(id: string) {
  const list = upTaskList.value
  const next: Array<UpTask> = []
  for (let i = 0; i < list.length; i++) {
    if (list[i].id !== id) next.push(list[i])
  }
  upTaskList.value = next
}

export function clearFinishedUpTasks() {
  const list = upTaskList.value
  const next: Array<UpTask> = []
  for (let i = 0; i < list.length; i++) {
    const s = list[i].status
    if (s === 'waiting' || s === 'uploading') next.push(list[i])
  }
  upTaskList.value = next
}

export function retryUpTask(id: string) {
  const t = findTask(id)
  if (t == null) return
  if (t.status === 'failed' || t.status === 'canceled') {
    t.status = 'waiting'
    t.percent = 0
    t.error = ''
    t.sizeText = '等待中…'
    if (pendingIds.indexOf(id) < 0) {
      pendingIds.push(id)
    }
    pump()
  }
}

/** 重试全部失败任务，返回重试数量（列表是最新在前，按加入顺序重排） */
export function retryAllFailedUpTasks(): number {
  const list = upTaskList.value
  const ids: Array<string> = []
  for (let i = 0; i < list.length; i++) {
    if (list[i].status === 'failed') {
      ids.push(list[i].id)
    }
  }
  for (let i = ids.length - 1; i >= 0; i--) {
    retryUpTask(ids[i])
  }
  return ids.length
}

/** 取消全部进行中与排队中的任务（批量上传时想中途停止用） */
export function cancelAllUpTasks(): number {
  const list = upTaskList.value
  let n = 0
  for (let i = 0; i < list.length; i++) {
    const t = list[i]
    if (t.status === 'waiting' || t.status === 'uploading') {
      cancelUpTask(t.id)
      n = n + 1
    }
  }
  return n
}
